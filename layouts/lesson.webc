---
layout: "base"
---
<script webc:setup>
	const copy = $data.copy.lesson;
	const link = (href, text) => `<a href="${href}">${text}</a>`;
</script>

<section class="lesson-list content-column wide">
	<eyebrow class="separators">
		<span @text="$data.term.label"></span>
		<span @text="$data.code"></span>
	</eyebrow>
	<h1 @text="copy.lessonPlans"></h1>
	<p @text="fill(copy.onePlanPerClass, { time: timeOfDay($data.schedule?.meetings?.time) })"></p>
	<p webc:if="$data.collections.deck?.length" @raw="fill(copy.everyDeckInMeeting, { link: link('/slides/', copy.slideIndex) })"></p>

	<p webc:if="$data.collections.assignment?.length" @raw="fill(copy.theBriefAndStarter, { link: link('/assignment/', copy.exercises) })"></p>

	<table class="table-light" webc:if="$data.term.instructorDates?.length">
		<thead>
			<tr>
				<th scope="col" @text="copy.instructorDeadlines"></th>
				<th scope="col" @text="copy.dueDate"></th>
			</tr>
		</thead>
		<tr webc:for="item of $data.term.instructorDates">
			<td @text="item.label"></td>
			<td @text="item.display"></td>
		</tr>
	</table>

	<table>
		<caption class="sr-only" @text="copy.everyClassMeetingOf"></caption>
		<thead>
			<tr>
				<th scope="col" @text="copy.date"></th>
				<th scope="col" @text="copy.links"></th>
				<th scope="col" @text="copy.topics"></th>
			</tr>
		</thead>
		<tbody>
			<tr webc:for="lesson of $data.lessons" :data-date="lesson.date">
				<td>
					<span @text="lesson.display"></span>
					<span class="muted" webc:if="lesson.substitution"><br/><span @text="fill(copy.runsASchedule, { weekday: lesson.substitution })"></span></span>
				</td>
				<td webc:if="lesson.noClass" colspan="2" class="muted no-class" @text="fill(copy.noClass, { reason: lesson.noClass })"></td>
				<template webc:else webc:nokeep>
					<td>
						<a :href="`/lessons/week-${lesson.week}/day-${lesson.day}/`" @text="copy.lessonPlan"></a>
						<span webc:nokeep webc:for="deck of ($data.collections.deck ?? []).filter((d) => d.data.week === lesson.week && d.data.day === lesson.day)">
							<br/><a :href="deck.url" @text="deck.data.addendum ? copy.addendum : copy.slides"></a>
							<br/><a :href="deckNotesUrl(deck.data.week, deck.data.day, deck.data.addendum === true)" @text="deck.data.addendum ? copy.addendumNotes : copy.notes"></a>
						</span>
						<span webc:nokeep webc:for="assignment of assignmentsDue($data.collections.assignment, lesson, $data.lessons)">
							<br/><span @text="copy.due"></span> <a :href="assignment.url" @text="assignment.title"></a> (<span @text="assignment.dueLabel"></span>)
						</span>
					</td>
					<td>
						<span webc:for="(topic, index) of lesson.topics" webc:nokeep>
							<span @raw="topic"></span><br/>
						</span>
					</td>
				</template>
			</tr>
		</tbody>
	</table>
</section>

<today-marker></today-marker>
