<!DOCTYPE html>
<html :lang="site.language ?? 'en-US'">

<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<meta name="color-scheme" content="light dark">

	<title @text="[$data.title, site.title].filter(Boolean).join(' | ')"></title>
	<meta name="robots" content="noindex, nofollow">

	<link rel="icon" href="/favicon.svg" type="image/svg+xml">

	<template webc:nokeep @raw="bundleFile('js', 'content/scripts/theme-restore.js', $data, 'head')"></template>
	<script webc:keep @raw="getBundle('js', 'head')"></script>

	<template webc:nokeep @raw="bundleFile('css', 'content/styles/deck.css', $data)"></template>
	<style webc:keep @raw="getBundle('css')"></style>
</head>

<body :data-accent="$data.accent" :style="$data.accentStyle">
	<a class="skip" href="#s1">Skip to first slide</a>
	<div class="topbar" role="presentation"></div>

	<main class="deck" tabindex="-1">
		<template webc:nokeep @raw="content"></template>
	</main>

	<div class="hud">
		<button type="button" data-prev aria-label="Previous slide">&larr;</button>
		<span data-count aria-live="polite">1 / 1</span>
		<button type="button" data-next aria-label="Next slide">&rarr;</button>
		<button type="button" data-toggle-theme aria-label="Cycle colour theme">&#9681;</button>
		<button type="button" data-toggle-fullscreen aria-pressed="false" aria-label="Toggle fullscreen" hidden>&#x26F6;</button>
	</div>

	<div class="rotate-hint">
		<svg viewBox="0 0 48 48" role="img" aria-hidden="true" width="48" height="48">
			<rect class="stroke" x="15" y="6" width="18" height="30" rx="3" stroke-width="2.5" fill="none"/>
			<path class="stroke-accent" d="M 8 42 Q 24 47 40 42" stroke-width="2.5" fill="none" stroke-linecap="round"/>
			<path class="stroke-accent" d="M 40 42 L 35 40 M 40 42 L 38 46" stroke-width="2.5" fill="none" stroke-linecap="round"/>
		</svg>
		<p>These slides are landscape &mdash; rotate your phone.</p>
	</div>

	<template webc:nokeep @raw="bundleFile('js', 'content/scripts/deck.js', $data)"></template>
	<script type="module" webc:keep @raw="getBundle('js')"></script>

</body>

</html>
