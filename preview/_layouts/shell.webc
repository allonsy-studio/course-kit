<!doctype html>
<html lang="en-US">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="color-scheme" content="light dark" />
		<meta name="robots" content="noindex, nofollow" />
		<title @text="[$data.title, 'Course kit preview'].filter(Boolean).join(' | ')"></title>
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<meta webc:is="oss-head" webc:nokeep />
		<style @raw="brandCss()"></style>
		<!-- The kit's base styles sit in a layer below Norn's, so a Norn component is styled by its own CSS, not the kit's. -->
		<style webc:keep @raw="'@layer kit, norn;\n@import url(' + url('/styles/font.css') + ') layer(kit);\n@import url(' + url('/styles/base.css') + ') layer(kit);'"></style>
		<link rel="stylesheet" href="/preview-assets/shell.css" webc:keep />
		<style webc:keep @raw="getBundle('css')"></style>
		<script webc:keep @raw="getBundle('js')"></script>
		<script src="/preview-assets/tokens.js" webc:keep></script>
		<script type="module" src="/preview-assets/canvas.js" webc:keep></script>
	</head>
	<body class="preview">
		<norn-skip-link></norn-skip-link>
		<oss-bar></oss-bar>
		<norn-header>
			<a slot="brand" rel="home" :href="chromeFor($data.page.url).home"><span webc:nokeep @text="chromeFor($data.page.url).name"></span></a>
			<a webc:for="link of chromeFor($data.page.url).nav" :href="link.href" :aria-current="link.current ? 'page' : undefined"><span webc:nokeep @text="link.title"></span></a>
		</norn-header>
		<preview-overrides></preview-overrides>
		<div class="app">
			<preview-nav :@groups="$data.catalog.groups" :@current="$data.page.url"></preview-nav>
			<main id="main" tabindex="-1"><template webc:nokeep @raw="content"></template></main>
		</div>
		<norn-footer>
			<div>
				<p><strong @text="chromeFor($data.page.url).footer.name"></strong></p>
				<p @text="chromeFor($data.page.url).footer.text"></p>
				<p webc:if="chromeFor($data.page.url).footer.license"><small>Licensed under <a :href="chromeFor($data.page.url).footer.license.url" @text="chromeFor($data.page.url).footer.license.name"></a></small></p>
			</div>
			<nav aria-label="Footer">
				<div webc:for="group of chromeFor($data.page.url).footer.groups">
					<p><strong @text="group.heading"></strong></p>
					<ul>
						<li webc:for="link of group.links"><a :href="link.href" @text="link.title"></a></li>
					</ul>
				</div>
			</nav>
			<oss-credit></oss-credit>
		</norn-footer>
	</body>
</html>
