<script webc:setup>
	/**
	 * One story in an iframe, with icon toggles for color scheme and width, an accessibility check, and a link to open it on its own.
	 * @prop {{ name: string, frameUrl: string, height?: number }} story
	 */
</script>
<figure webc:root="override" class="canvas" data-canvas>
	<!-- A form of its own makes the radio names local to this canvas. -->
	<form class="canvas-bar" onsubmit="return false">
		<norn-segmented-control :@icon-only="true">
			<span slot="legend">Color scheme</span>
			<label title="Light"><input type="radio" name="scheme" value="light" /><norn-icon @name="sun" @size="m"></norn-icon><span>Light</span></label>
			<label title="System"><input type="radio" name="scheme" value="system" checked /><norn-icon @name="system" @size="m"></norn-icon><span>System</span></label>
			<label title="Dark"><input type="radio" name="scheme" value="dark" /><norn-icon @name="moon" @size="m"></norn-icon><span>Dark</span></label>
		</norn-segmented-control>
		<norn-segmented-control class="widths" :@icon-only="true">
			<span slot="legend">Width</span>
			<label title="Fill"><input type="radio" name="width" value="" checked /><norn-icon @name="fill" @size="m"></norn-icon><span>Fill</span></label>
			<label title="Phone, 320px"><input type="radio" name="width" value="320" /><norn-icon @name="phone" @size="m"></norn-icon><span>Phone, 320px</span></label>
			<label title="Tablet, 768px"><input type="radio" name="width" value="768" /><norn-icon @name="tablet" @size="m"></norn-icon><span>Tablet, 768px</span></label>
			<label title="Desktop, 1024px"><input type="radio" name="width" value="1024" /><norn-icon @name="desktop" @size="m"></norn-icon><span>Desktop, 1024px</span></label>
		</norn-segmented-control>
		<button type="button" data-axe data-state="idle" title="Check accessibility">
			<norn-icon @name="accessibility" @size="m" data-for="idle"></norn-icon>
			<norn-icon @name="loading" @size="m" data-for="running"></norn-icon>
			<norn-icon @name="success" @size="m" data-for="pass"></norn-icon>
			<norn-icon @name="error" @size="m" data-for="fail"></norn-icon>
			<span class="sr-only">Check accessibility</span>
		</button>
	</form>
	<div class="stage"><iframe :src="story.frameUrl" :title="story.name" loading="lazy" :style="story.height ? 'min-block-size: ' + story.height + 'px' : ''"></iframe></div>
	<p class="open"><a :href="story.frameUrl">Open on its own</a></p>
	<output class="axe-result" aria-live="polite"></output>
</figure>
