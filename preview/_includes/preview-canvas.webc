<script webc:setup>
	/**
	 * One story in an iframe, with color-scheme and width controls and an accessibility check.
	 * @prop {{ name: string, frameUrl: string, height?: number }} story
	 */
</script>
<figure webc:root="override" class="canvas" data-canvas>
	<div class="canvas-bar" role="group" aria-label="Canvas controls">
		<fieldset>
			<legend>Color scheme</legend>
			<label><input type="radio" :name="'scheme-' + story.frameUrl" value="light" /> Light</label>
			<label><input type="radio" :name="'scheme-' + story.frameUrl" value="system" checked /> System</label>
			<label><input type="radio" :name="'scheme-' + story.frameUrl" value="dark" /> Dark</label>
		</fieldset>
		<fieldset class="widths">
			<legend>Width</legend>
			<label><input type="radio" :name="'width-' + story.frameUrl" value="" checked /> Fill</label>
			<label><input type="radio" :name="'width-' + story.frameUrl" value="320" /> Phone</label>
			<label><input type="radio" :name="'width-' + story.frameUrl" value="768" /> Tablet</label>
			<label><input type="radio" :name="'width-' + story.frameUrl" value="1024" /> Desktop</label>
		</fieldset>
		<button type="button" data-axe>Check accessibility</button>
	</div>
	<div class="stage"><iframe :src="story.frameUrl" :title="story.name" loading="lazy" :style="story.height ? 'min-block-size: ' + story.height + 'px' : ''"></iframe></div>
	<output class="axe-result" aria-live="polite"></output>
</figure>
