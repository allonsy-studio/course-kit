<script webc:setup>
	/**
	 * The component list: a sidebar on a wide screen, one closed disclosure on a phone. Each group is a `norn-side-nav`.
	 * @prop {object[]} groups the catalog's groups
	 */
</script>
<details webc:root="override" class="nav" open>
	<summary>Components</summary>
	<section webc:for="group of groups" :aria-labelledby="'nav-' + group.id">
		<h2 :id="'nav-' + group.id" @text="group.title"></h2>
		<norn-side-nav :@items="group.components.map((component) => ({ href: component.url, title: component.tag }))">
			<span slot="label" @text="group.title"></span>
		</norn-side-nav>
	</section>
</details>
