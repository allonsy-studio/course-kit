<script webc:setup>
	/**
	 * A table of color tokens with an override field in each row. A value applies to every frame on the page.
	 * @prop {{ name: string, role: string }[]} rows
	 */
</script>
<table webc:root="override" class="tokens" data-tokens>
	<thead>
		<tr><th scope="col">Token</th><th scope="col">Colors</th><th scope="col">Try a value</th></tr>
	</thead>
	<tbody>
		<tr webc:for="token of rows">
			<th scope="row"><code @text="token.name"></code></th>
			<td @text="token.role"></td>
			<td><input type="text" :data-token="token.name" :aria-label="'Override ' + token.name" placeholder="any CSS color" /></td>
		</tr>
	</tbody>
</table>
