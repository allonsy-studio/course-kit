{
  "name": "@allons-y/course-kit",
  "version": "0.1.0-alpha.0",
  "description": "Shared layouts, components, styles and build helpers for Eleventy course sites.",
  "license": "MPL-2.0",
  "author": "Cassondra Roberts <castastrophe@users.noreply.github.com> (https://allons-y.studio)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/allonsy-studio/course-kit.git"
  },
  "bugs": {
    "url": "https://github.com/allonsy-studio/course-kit/issues"
  },
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./data": "./lib/data/index.js",
    "./filters": "./lib/filters.js",
    "./markdown": "./lib/markdown.js",
    "./package.json": "./package.json",
    "./postcss": "./lib/postcss.js",
    "./schemas/*": "./schemas/*",
    "./theme": "./lib/theme.js",
    "./worksheets": "./lib/worksheets.js"
  },
  "files": [
    "index.js",
    "lib",
    "layouts",
    "components",
    "assets",
    "glue",
    "schemas"
  ],
  "scripts": {
    "test": "node --test",
    "schema": "node scripts/theme-schema.js && node scripts/theme-docs.js",
    "docs": "node scripts/component-docs.js",
    "preview": "node scripts/site.js start",
    "preview:build": "node scripts/site.js build",
    "docs:build": "node scripts/site.js build",
    "docs:start": "node scripts/site.js start",
    "docs:test": "cypress run --project website",
    "pages:build": "node scripts/site.js build",
    "format": "opx lint --fix",
    "lint": "opx lint"
  },
  "dependencies": {
    "@11ty/eleventy-navigation": "^1.0.5",
    "@11ty/eleventy-plugin-syntaxhighlight": "^5.0.2",
    "@11ty/eleventy-plugin-webc": "^0.11.2",
    "@allons-y/dashly": "^1.0.0-beta.1",
    "cssnano": "^9.9.0",
    "cssnano-preset-advanced": "^9.7.0",
    "dotenv": "^17.4.2",
    "eleventy-plugin-toc": "^1.1.5",
    "esbuild": "^0.28.2",
    "gray-matter": "^4.0.3",
    "html-minifier-terser": "^7.2.0",
    "htmlnano": "^3.6.1",
    "markdown-it": "^14.3.3",
    "markdown-it-anchor": "^10.0.0",
    "markdown-it-footnote": "^4.0.0",
    "postcss": "^8.5.32",
    "postcss-import": "^17.0.1",
    "postcss-preset-env": "^11.6.2",
    "posthtml": "^0.16.7",
    "prettier": "^3.9.10",
    "prism-themes": "^1.9.0",
    "prismjs": "^1.30.0"
  },
  "peerDependencies": {
    "@11ty/eleventy": "^3.1.0",
    "@pyscript/core": ">=0.7",
    "puppeteer": ">=24",
    "pyodide": ">=314"
  },
  "peerDependenciesMeta": {
    "@pyscript/core": {
      "optional": true
    },
    "puppeteer": {
      "optional": true
    },
    "pyodide": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "yarn@4.18.1",
  "devDependencies": {
    "@11ty/eleventy": "^3.1.8",
    "@allons-y/opx-cli": "^0.1.0-beta.2",
    "@allons-y/opx-lint-js": "^0.1.0-beta.0",
    "@allons-y/opx-lint-json": "^0.1.0-beta.2",
    "@allons-y/opx-lint-md": "^0.1.0-beta.2",
    "@allons-y/webc-code-sample": "0.1.0-beta.3",
    "@allons-y/webc-oss-site": "0.1.0-beta.3",
    "@allons-y/webc-patterns": "0.1.0-beta.3",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "axe-core": "^4.14.0",
    "cypress": "^15.21.1",
    "cypress-axe": "^1.7.0",
    "typescript": "^6.0.3"
  },
  "oss-docs": {
    "site": "website",
    "flavor": "landing"
  }
}
