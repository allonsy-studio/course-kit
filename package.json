{
  "name": "@allons-y/course-kit",
  "version": "0.1.0-alpha.0",
  "description": "Shared layouts, components, styles and build helpers for Eleventy course sites.",
  "license": "MPL-2.0",
  "author": "Cassondra Roberts <castastrophe@users.noreply.github.com> (https://allons-y.studio)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/allonsy-studio/course-kit.git"
  },
  "bugs": {
    "url": "https://github.com/allonsy-studio/course-kit/issues"
  },
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./data": "./lib/data/index.js",
    "./filters": "./lib/filters.js",
    "./markdown": "./lib/markdown.js",
    "./package.json": "./package.json",
    "./postcss": "./lib/postcss.js",
    "./schemas/*": "./schemas/*",
    "./theme": "./lib/theme.js",
    "./worksheets": "./lib/worksheets.js"
  },
  "files": [
    "index.js",
    "lib",
    "layouts",
    "components",
    "assets",
    "glue",
    "schemas"
  ],
  "scripts": {
    "test": "node --test",
    "schema": "node scripts/theme-schema.js && node scripts/theme-docs.js",
    "docs": "node scripts/component-docs.js",
    "preview": "eleventy --config=preview/eleventy.config.js --serve",
    "preview:build": "eleventy --config=preview/eleventy.config.js"
  },
  "dependencies": {
    "@11ty/eleventy-navigation": "^1.0.5",
    "@11ty/eleventy-plugin-syntaxhighlight": "^5.0.2",
    "@11ty/eleventy-plugin-webc": "^0.11.2",
    "@allons-y/dashly": "^0.1.0-beta.0",
    "cssnano": "^9.0.5",
    "cssnano-preset-advanced": "^9.0.5",
    "dotenv": "^17.4.2",
    "eleventy-plugin-toc": "^1.1.5",
    "esbuild": "^0.28.2",
    "gray-matter": "^4.0.3",
    "html-minifier-terser": "^7.2.0",
    "htmlnano": "^3.5.1",
    "markdown-it": "^14.3.2",
    "markdown-it-anchor": "^10.0.0",
    "markdown-it-footnote": "^4.0.0",
    "postcss": "^8.5.28",
    "postcss-import": "^17.0.0",
    "postcss-preset-env": "^11.5.3",
    "posthtml": "^0.16.7",
    "prettier": "^3.9.8",
    "prism-themes": "^1.9.0",
    "prismjs": "^1.30.0"
  },
  "peerDependencies": {
    "@11ty/eleventy": "^3.1.0",
    "@pyscript/core": ">=0.7",
    "puppeteer": ">=24",
    "pyodide": ">=314"
  },
  "peerDependenciesMeta": {
    "@pyscript/core": {
      "optional": true
    },
    "puppeteer": {
      "optional": true
    },
    "pyodide": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "yarn@4.18.1",
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "axe-core": "^4.14.0"
  }
}
