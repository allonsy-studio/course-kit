 "all": "\n<section id=\"instructor\" aria-labelledby=\"instructor-heading\">\n    \n        <div class=\"who\">\n            <img src=\"/images/sam.webp\" alt=\"Dr. Sam Example\" width=\"160\" height=\"160\" class=\"photo screen-only\">\n            <div class=\"facts-column\">\n                <h2 id=\"instructor-heading\">Your instructor</h2>\n                <dl class=\"facts\">\n                    <div class=\"name\">\n                        <dt class=\"sr-only\">Name</dt>\n                        <dd><strong><span>Dr. Sam Example</span></strong></dd>\n                    </div>\n                    <div>\n                        <dt>Office</dt>\n                        <dd>SMB 251</dd>\n                    </div>\n                    <div>\n                        <dt>Office hours</dt>\n                        <dd>\n                            <ul role=\"list\">\n                                <li>by appointment</li>\n                            </ul>\n                        </dd>\n                    </div>\n                    <div class=\"print-only\">\n                        <dt>Email</dt>\n                        <dd><a data-email=\"c2FtLmV4YW1wbGVAZXhhbXBsZS5lZHU=\"></a></dd>\n                    </div>\n                    <div class=\"screen-only\">\n                        <dt>Message</dt>\n                        <dd><a href=\"/contact/\">Send me a message</a></dd>\n                    </div>\n                    <div>\n                        <dt>Blog</dt>\n                        <dd><a href=\"https://sam.example.edu/blog/\">sam.example.edu/blog</a></dd>\n                    </div>\n                </dl>\n                <p class=\"muted note\">I reply within a day.</p>\n            </div>\n        </div>\n    \n\n    \n</section>\n\n<style>.wcgdwpi5v .who{display:flex;align-items:flex-start;gap:calc(var(--content-space)*1.1);@media print{display:block}}.wcgdwpi5v .facts-column{min-inline-size:0;flex:1 1 auto}.wcgdwpi5v .facts-column h2{margin-block:0 0.35em;font-size:var(--font-size-6);font-weight:var(--font-weight--semi-bold);letter-spacing:0.08em;text-transform:uppercase;color:var(--color-text-muted)}.wcgdwpi5v .facts{display:grid;grid-template-columns:max-content minmax(0,1fr);column-gap:var(--content-space);row-gap:0.3em;margin:0;> div {\n            display: contents;\n        }\n\n        /* `display: contents` outranks the utility classes, so restate them\n           for rows that appear on one medium only. */\n        > div.print-only {\n            display: none;\n        }\n\n        dt {\n            color: var(--color-text-muted);\n            font-size: var(--font-size-6);\n            letter-spacing: 0.05em;\n            text-transform: uppercase;\n            line-height: var(--font-height);\n            padding-block-start: 0.15em;\n        }\n\n        dd {\n            margin: 0;\n        }\n\n        ul {\n            list-style: none;\n            margin: 0;\n            padding: 0;\n        }\n\n        .name dd {\n            grid-column: 1 / -1;\n            font-size: var(--font-size-4);\n            line-height: var(--font-height--dense);\n            margin-block-end: 0.35em;\n        }\n\n        @media print {\n            display: inline;\n        }}.wcgdwpi5v .note{margin-block:0.75em 0;font-size:max(var(--base-font-size),0.9em)}.wcgdwpi5v .photo{flex:none;inline-size:5.5em;block-size:5.5em;border-radius:var(--circle-border-radius);object-fit:cover;border:var(--thin-border-width) solid var(--color-border)}.wcgdwpi5v .instructor-contact{margin-block:0}.wcgdwpi5v .instructor-card{display:flex;align-items:flex-start;gap:var(--content-space);max-inline-size:min(60ch,100%);margin-inline:auto;padding:calc(var(--content-space)*1.2);background-color:var(--color-surface);border:var(--thin-border-width) solid var(--color-border);border-radius:var(--standard-border-radius)}.wcgdwpi5v .instructor-card .photo{inline-size:4em;block-size:4em}.wcgdwpi5v .monogram{flex:none;display:grid;place-items:center;inline-size:2.75em;block-size:2.75em;margin:0;background-color:var(--color-surface-accent);border-radius:50%;color:var(--color-accent-text);font-weight:var(--font-weight--semi-bold)}.wcgdwpi5v .instructor-name{margin-block:0 0.15em;font-size:max(var(--base-font-size),1.15em)}.wcgdwpi5v .instructor-meta{margin-block:0 0.75em;color:var(--color-text-muted);font-size:max(var(--base-font-size),0.92em)}.wcgdwpi5v .cta{color:var(--color-link)}.wcgdwpi5v a[data-email]{display:inline-flex;align-items:center;min-block-size:var(--target-min);overflow-wrap:anywhere;min-inline-size:0}.wcgdwpi5v .instructor-card>*,.wcgdwpi5v .who>*{min-inline-size:0}@media screen and (width < 30em){.wcgdwpi5v .instructor-card,.wcgdwpi5v .who{flex-direction:column}.wcgdwpi5v .facts{grid-template-columns:minmax(0,1fr)}.wcgdwpi5v .facts dt{padding-block-start:0.4em}}@media print{.wcgdwpi5v#instructor .facts>div.screen-only{display:none}}</style>\n\n<script>\n\tfor (const link of document.querySelectorAll(\"a[data-email]\")) {\n\t\tconst email = atob(link.dataset.email);\n\t\tlink.href = `mailto:${email}`;\n\t\t// Break opportunities before \"@\" and after each \".\": a narrow screen wraps the address there, not mid-word.\n\t\tlink.textContent = \"\";\n\t\temail.split(/(?=@)|(?<=\\.)/).forEach((part, index) => {\n\t\t\tif (index) link.append(document.createElement(\"wbr\"));\n\t\t\tlink.append(part);\n\t\t});\n\t}\n</script>\n",
