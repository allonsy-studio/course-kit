ock:0 0.75em;color:var(--color-text-muted);font-size:max(var(--base-font-size),0.92em)}.wcgdwpi5v .cta{color:var(--color-link)}.wcgdwpi5v a[data-email]{display:inline-flex;align-items:center;min-block-size:var(--target-min);overflow-wrap:anywhere;min-inline-size:0}.wcgdwpi5v .instructor-card>*,.wcgdwpi5v .who>*{min-inline-size:0}@media screen and (width < 30em){.wcgdwpi5v .instructor-card,.wcgdwpi5v .who{flex-direction:column}.wcgdwpi5v .facts{grid-template-columns:minmax(0,1fr)}.wcgdwpi5v .facts dt{padding-block-start:0.4em}}@media print{.wcgdwpi5v#instructor .facts>div.screen-only{display:none}}</style>\n\n<script>\n\tfor (const link of document.querySelectorAll(\"a[data-email]\")) {\n\t\tconst email = atob(link.dataset.email);\n\t\tlink.href = `mailto:${email}`;\n\t\t// Break opportunities before \"@\" and after each \".\": a narrow screen wraps the address there, not mid-word.\n\t\tlink.textContent = \"\";\n\t\temail.split(/(?=@)|(?<=\\.)/).forEach((part, index) => {\n\t\t\tif (index) link.append(document.createElement(\"wbr\"));\n\t\t\tlink.append(part);\n\t\t});\n\t}\n</script>\n",
