<details class="cite" :name="group">
	<summary :aria-label="label">
		<span aria-hidden="true" webc:if="marker" @text="marker"></span>
		<span aria-hidden="true" webc:if="!marker">?</span>
	</summary>
	<div class="cite-body">
		<p webc:if="heading" @text="heading"></p>
		<ul>
			<li webc:for="source of sources">
				<a :href="source.href" @text="source.label"></a>
				<q webc:if="source.quote" @text="source.quote"></q>
			</li>
		</ul>
	</div>
</details>

<style webc:scoped>
	:host {
		flex: none;

		details {
			background: none;
			border: 0;
			margin-block: 0;
			padding: 0;
			position: relative;

			&[open] summary {
				background: var(--color-accent);
				color: var(--color-on-accent);
			}
		}

		summary {
			background: var(--color-surface);
			block-size: 1.7em;
			border: var(--thin-border-width) solid var(--color-border);
			border-radius: var(--circle-border-radius);
			cursor: pointer;
			font-weight: var(--font-weight--bold);
			inline-size: 1.7em;
			line-height: 1.6;
			list-style: none;
			padding: 0;
			text-align: center;

			&::-webkit-details-marker {
				display: none;
			}
		}

		.cite-body {
			background: var(--color-surface-overlay);
			border: var(--thin-border-width) solid var(--color-border);
			border-radius: var(--standard-border-radius);
			box-shadow: var(--box-shadow);
			font-size: 0.9em;
			inline-size: min(34rem, 80vw);
			inset-block-start: 2.2em;
			inset-inline-end: 0;
			padding: 0.8em 1em;
			position: absolute;
			z-index: 10;

			p {
				font-weight: var(--font-weight--semi-bold);
				margin-block: 0 0.4em;
			}

			ul {
				list-style: none;
				margin-block: 0;
				padding-inline-start: 0;
			}

			li + li {
				margin-block-start: 0.6em;
			}

			q {
				color: var(--color-text-muted);
				display: block;
				font-style: italic;
			}
		}

		@media print {
			.cite-body {
				box-shadow: none;
				inline-size: auto;
				position: static;
			}
		}
	}
</style>
