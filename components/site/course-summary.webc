<script webc:setup>
	/**
	 * The course home page's body: the description, the instructor, the syllabus
	 * and the schedule. Reads the `course`, `grading`, `schedule`, `instructor`
	 * and `term` data; it takes no props.
	 */
	const course = $data.course ?? {};
	const copy = $data.copy.courseSummary;
	const escape = (text) => String(text).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/"/g, "&quot;");
	/** When the final project is due, from `project.json`: "Thursday, December 3, 2026, 11:59PM". */
	const projectWhen = () => {
		const project = $data.project;
		if (!project?.due) return fill($data.copy.syllabus.atTheLastClassMeeting, { lastMeeting: lastMeeting($data.lessons) });
		return project.dueTime ? fill($data.copy.syllabus.projectDue, { date: fullDate(project.due), time: timeOfDay(project.dueTime) }) : fullDate(project.due);
	};
	/** "This section's final exam is …, see the Coursework section." with the link in place. */
	const finalExamLine = () => fill(copy.thisSectionsFinalExamIs, { slot: escape(examSlot($data.schedule.finalExam)), link: `<a href="#coursework">${escape(copy.coursework)}</a>` });
	/** "The final project is due …; its milestones and rubric are on the project page." with the link in place. */
	const projectDue = () => fill(copy.projectDue, { when: escape(projectWhen()), link: `<a href="${escape($data.project?.url ?? "/projects/final/")}">${escape(copy.projectPageLink)}</a>` });
</script>
<article class="content-column wide" webc:root="override" webc:if="$data.course">
	<header class="course-header">
		<eyebrow class="print-only" @text="$data.term.label"></eyebrow>
		<h1 class="print-only"><span @text="course.code"></span>: <span @text="course.name"></span></h1>
		<p class="lede" @text="course.description"></p>
		<p webc:if="course.prerequisites?.length">
			<strong @text="copy.prerequisites"></strong>
			<span @text="course.prerequisites.join(', ')"></span><span webc:if="course.prerequisiteNote">, <span @text="course.prerequisiteNote"></span></span>
		</p>
	</header>

	<section id="approach" aria-labelledby="approach-heading" webc:if="course.approach">
		<h2 id="approach-heading" @text="copy.howThisSectionIs"></h2>
		<p @text="course.approach"></p>
	</section>

	<instructor></instructor>

	<syllabus></syllabus>

	<section id="schedule" aria-labelledby="schedule-heading">
		<h2 id="schedule-heading" @text="copy.scheduleClassResources"></h2>
		<p>
			<span @text="copy.thisIsAProposed"></span>
			<span @text="copy.eachWeekListsWhatTo"></span>
			<span webc:if="$data.grading?.homework" @text="fill(copy.allAssignmentsWillBe, { lms: $data.site.lms })"></span>
			<span webc:if="$data.grading?.project" @raw="projectDue()"></span>
			<span webc:if="$data.grading?.final && !$data.schedule?.finalExam" @text="fill(copy.theFinalExamFalls, { period: $data.term.finalExamsDisplay })"></span>
			<span webc:if="$data.grading?.final && $data.schedule?.finalExam" @raw="finalExamLine()"></span>
		</p>
		<div class="print-only">
			<p>
				<span @text="fill(copy.thisDocumentOmitsTheWeekbyweek, { live: $data.site?.url ? fill(copy.theLiveScheduleIsPublished, { url: `${$data.site.url}${$data.page.url}#schedule` }) : '' })"></span>
				<span webc:if="$data.grading?.project" @text="fill(copy.projectDueShort, { when: projectWhen() })"></span>
			</p>
		</div>
		<schedule-weeks></schedule-weeks>
	</section>
</article>

<style webc:scoped>
	/* The wide column, laid out as a grid so the catalog copy and the
	   teaching approach sit beside the instructor panel; the syllabus and
	   the schedule then take the full width. Nothing is wrapped, so
	   print.css's id and class hooks are untouched; print falls back to a
	   plain block flow. */
	:host {
		display: grid;
		grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
		column-gap: calc(var(--section-space) * 1.5);
		row-gap: var(--content-space);
		align-items: start;

		@media screen and (width <= 900px) {
			grid-template-columns: minmax(0, 1fr);
		}

		@media print {
			display: block;
		}
	}

	:host > .course-header {
		grid-column: 1;
		margin-block-end: 0;
	}

	:host > #approach {
		grid-column: 1;
	}

	:host > #instructor {
		grid-column: 2;
		grid-row: 1 / span 2;
		box-sizing: border-box;
		padding: calc(var(--content-space) * 1.2);
		background-color: var(--color-surface);
		border: var(--thin-border-width) solid var(--color-border);
		border-radius: var(--standard-border-radius);

		@media screen and (width <= 900px) {
			grid-column: 1;
			grid-row: auto;
		}

		@media print {
			padding: 0;
			background: none;
			border: none;
		}
	}

	:host > #syllabus,
	:host > #schedule {
		grid-column: 1 / -1;
	}

	:host > #schedule {
		margin-block-start: var(--section-space);
	}

	@media screen {
		:host > .course-header .lede,
		:host > #approach p {
			max-inline-size: 70ch;
		}

		:host > #schedule > p {
			max-inline-size: 90ch;
		}
	}
</style>
