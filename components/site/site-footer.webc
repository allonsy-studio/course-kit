<script webc:setup>
	/**
	 * The page footer: course, institution, term, copyright and the links. Reads `course`, `site` and `term`.
	 */
</script>
<div webc:root="override">
    <div class="brand">
        <p class="course"><a href="/"><span @text="$data.course.code"></span>: <span @text="$data.course.name"></span></a></p>
        <p class="meta separators">
            <span @text="$data.site.institution"></span>
            <span @text="$data.term.label"></span>
        </p>
        <copyright></copyright>
    </div>
    <div class="group">
        <p class="label" id="footer-pages" @text="$data.copy.siteFooter.pages"></p>
        <nav-links column aria-labelledby="footer-pages" @context="footer" :@navigation="eleventyNavigation($data.collections.all)"></nav-links>
    </div>
    <nav class="group" aria-labelledby="footer-policies" webc:if="$data.policies">
        <p class="label" id="footer-policies" @text="$data.copy.siteFooter.policies"></p>
        <ul role="list">
            <li webc:for="(key, policy) in Object.fromEntries(Object.entries($data.policies).filter(([name]) => name !== '$schema'))">
                <a :href="policy.href?.startsWith('/') ? policy.href : `/#policy-${key}`" @text="policy.title"></a>
            </li>
        </ul>
    </nav>
</div>

