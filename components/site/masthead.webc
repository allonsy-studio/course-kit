<script webc:setup>
	/**
	 * The page header: institution, term, course title and the navigation. Reads `site`, `term` and `course`.
	 * The menu is Home, Syllabus, then every page of the site menu that has not set `menu: false`. A page other pages name as their `eleventyNavigation.parent` is a group: its link, then theirs.
	 * When the instructor has a `booking` link, it is shown under the meeting line on every page, and the menu leaves Contact to the footer.
	 * @prop {'auto' | 1 | 2} [navColumns] how many columns the menu is set in: `auto` (the default) sets it in two columns when it has more than 3 links, so a long menu keeps the header short, and in one stack otherwise; `1` and `2` fix it either way. The same as `"navColumns"` in `course.json`, and wins over it
	 */
	/** Links shown in the hero menu before which the menu stays a single stack. */
	const MAX_STACKED = 3;
	/** The prop wins over the course's `navColumns`; `auto`, or nothing, counts the links the hero shows (the instructor's contact link is one of them). */
	const twoColumns = (data, prop, linkCount) => {
		const wanted = prop ?? data.course?.navColumns;
		if (wanted === undefined || wanted === "auto") return linkCount + (data.instructor?.contact && !data.instructor?.booking?.url ? 1 : 0) > MAX_STACKED;
		return Number(wanted) === 2;
	};
	/** A page's children that have not left the menu. */
	const inMenu = (item) => ({ ...item, children: (item.children ?? []).filter((child) => child.menu !== false) });
	const navItems = (() => {
		const items = eleventyNavigation($data.collections.all);
		const home = items.find((item) => item.url === "/");
		const rest = items.filter((item) => item.url !== "/");
		return [...(home ? [home] : []), { url: "/#syllabus", title: $data.copy.nav.syllabus }, ...rest.filter((item) => item.menu !== false).map(inMenu)];
	})();
	/** Every link the menu shows, a group's children included. */
	const linkCount = navItems.reduce((count, item) => count + 1 + (item.children?.length ?? 0), 0);
</script>
<header webc:root="override" id="header">
    <div class="container">
        <div class="identity">
            <eyebrow class="separators">
                <span @text="$data.site.institution"></span>
                <span @text="$data.term.label"></span>
            </eyebrow>
            <h1 class="course-title" webc:if="$data.page.url === '/'">
                <a href="/" aria-current="page"><span class="code" @text="$data.course.code"></span> <span class="name" @text="$data.course.name"></span></a>
            </h1>
            <p class="course-title" webc:else>
                <a href="/"><span class="code" @text="$data.course.code"></span> <span class="name" @text="$data.course.name"></span></a>
            </p>
            <p class="meta separators" webc:if="$data.schedule?.meetings?.days?.length">
                <span @text="$data.schedule.meetings.days.length > 1 ? `${$data.schedule.meetings.days.slice(0, -1).join(', ')} & ${$data.schedule.meetings.days.at(-1)}` : $data.schedule.meetings.days[0]"></span>
                <span webc:if="$data.schedule.meetings.time" @text="$data.schedule.meetings.time"></span>
                <span webc:if="$data.instructor?.office" @text="$data.instructor.office"></span>
            </p>
            <p class="booking" webc:if="$data.instructor?.booking?.url">
                <a :href="$data.instructor.booking.url" @text="$data.instructor.booking.label || $data.copy.instructor.bookAnAppointment"></a>
            </p>
        </div>
        <div class="links">
            <nav-links column two-column webc:if="twoColumns($data, typeof navColumns === 'undefined' ? undefined : navColumns, linkCount)" :aria-label="$data.copy.nav.site" @context="hero" :@navigation="navItems"></nav-links>
            <nav-links column webc:else :aria-label="$data.copy.nav.site" @context="hero" :@navigation="navItems"></nav-links>
        </div>
    </div>
</header>

<style webc:scoped>
/* A hero, not a bar: the course identity at full size on the left, the
   site's internal links stacked on the right. It scrolls away with the
   page — nothing is sticky — so anchor targets need no offset. */
:host {
    /* base.css's `body > header { grid-column: 1 / -1; }` is what keeps
       this full-bleed; everything else about the plain banner treatment is
       overridden here. */
    text-align: start;
    padding: 0;

    /* A soft wash of the course accent that has faded fully into the page
       surface by the bottom edge, so the band needs no closing rule. */
    background: linear-gradient(
        to bottom,
        color-mix(in sRGB, var(--color-accent) 7%, var(--color-page)),
        var(--color-page)
    );

    @media print {
        display: none;
    }

    > .container {
        box-sizing: border-box;
        /* Match the content column (`--page-column`, set on body). */
        inline-size: var(--page-column);
        margin-inline: auto;
        margin-block: 0;
        padding-inline: 0;
        padding-block: calc(var(--section-space) * 1.25) var(--section-space);

        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        column-gap: calc(var(--section-space) * 2);
        row-gap: var(--content-space);
        align-items: start;

        @media screen and (width <= 768px) {
            grid-template-columns: minmax(0, 1fr);
            padding-block: var(--section-space) calc(var(--section-space) * 0.75);
        }
    }

    .identity {
        display: grid;
        gap: calc(var(--content-space) * 0.6);

        > * {
            margin: 0;
            max-inline-size: none;
        }
    }

    .course-title {
        margin: 0;
        max-inline-size: none;
        font-family: var(--display-font);
        font-size: clamp(1.75rem, 1.1rem + 2.4vw, 2.75rem);
        font-weight: var(--font-weight--semi-bold);
        line-height: 1.1;
        letter-spacing: -0.01em;
        text-wrap: balance;

        a {
            color: var(--color-text);
            text-decoration: none;

            &:is(:hover, :focus-visible) .name {
                text-decoration: underline;
                text-decoration-thickness: 0.06em;
                text-underline-offset: 0.12em;
                text-decoration-color: var(--color-accent);
            }
        }

        .code {
            display: block;
            font-size: 0.5em;
            font-weight: var(--font-weight--semi-bold);
            letter-spacing: 0.06em;
            color: var(--color-accent-text);
            margin-block-end: 0.2em;
        }
    }

    .meta {
        margin: 0;
        color: var(--color-text-muted);
        font-size: max(var(--base-font-size), 0.95em);
    }

    /* The booking link: an outlined pill, a 44px target, on every page. */
    .booking a {
        display: inline-flex;
        align-items: center;
        min-block-size: var(--target-min);
        padding-inline: 1.25em;
        border: var(--border-width) solid var(--color-accent-text);
        border-radius: var(--radius-pill);
        color: var(--color-accent-text);
        font-weight: var(--font-weight--semi-bold);
        text-decoration: none;

        &:is(:hover, :focus-visible) {
            background-color: var(--color-accent);
            border-color: var(--color-accent);
            color: var(--color-on-accent);
        }
    }

    .links {
        display: flex;
        align-items: start;
        gap: calc(var(--content-space) * 1.5);
        padding-inline-start: calc(var(--section-space) * 1.25);
        border-inline-start: var(--thin-border-width) solid var(--color-border);

        @media screen and (width <= 768px) {
            inline-size: 100%;
            justify-content: space-between;
            padding-inline-start: 0;
            padding-block-start: var(--content-space);
            border-inline-start: none;
            border-block-start: var(--thin-border-width) solid var(--color-border);
        }
    }
}
</style>
