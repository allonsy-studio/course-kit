<script webc:setup>
	/**
	 * The site navigation as a list of links, marking the current page. Give it the `navigation` array, or write the links in the default slot
	 * as a `<ul>` of `<li><a>`; the array wins when it has items, and when it is missing or empty the slot is rendered instead.
	 * @prop {{ url: string, title: string }[]} navigation pages from `eleventyNavigation`
	 * @prop {'footer' | 'hero'} [context] adds the instructor's contact link in the footer and the hero
	 */
</script>
<nav webc:root="override" :data-context="context">
    <ul role="list" webc:if="navigation?.length">
        <li webc:for="item of navigation">
            <a :href="item?.url" @attributes="({ 'aria-current': item?.url === $data?.page?.url ? 'page' : undefined })" @text="item?.title"></a>
        </li>
        <li webc:if="$data.instructor?.contact && (context === 'footer' || context === 'hero')"><a :href="$data.instructor.contact" @text="$data.copy.nav.contact"></a></li>
    </ul>
    <slot webc:if="!navigation?.length"></slot>
</nav>
<style webc:scoped>
:host:not(:has(li)) {
    display: none;
}

:host {
    display: flex;
    gap: calc(var(--container-space) * 3.5);

    ul {
        list-style: none;
        margin: 0;
        padding: 0;

        display: inline-flex;
        flex-wrap: wrap;
        justify-content: space-evenly;
        inline-size: 100%;
        gap: calc(var(--content-space) * 1.6);

        @media screen and (width <= 612px) {
            justify-content: flex-start;
            column-gap: calc(var(--content-space) * 0.75);
            row-gap: calc(var(--content-space) * 0.25);
        }
    }

    li {
        font-size: 1em;
    }

    /* `a[href]` outranks the page's underline for links in lists. A menu is
       not a sentence: it carries no underline until you point at it, and the
       current page keeps an accent one. */
    a[href] {
        /* Inline padding is left alone; the block padding lifts each link to
           the 24px minimum target size without changing the row rhythm. */
        display: inline-flex;
        align-items: center;
        min-block-size: var(--target-min);
        min-inline-size: var(--target-min);
        padding-block: 0.2em;
        font-size: max(var(--base-font-size), 0.95em);
        color: inherit;
        text-decoration: none;

        /* The current page keeps an underline here; the hero menu fills it (below). */
        &[aria-current="page"] {
            text-decoration: underline;
            text-decoration-color: var(--color-accent-text);
            text-decoration-thickness: var(--border-width);
            text-underline-offset: 0.4ex;
        }

        &:not([aria-current="page"]):is(:hover, :focus-visible) {
            color: var(--color-link-hover);
            text-decoration: underline;
            text-decoration-thickness: var(--thin-border-width);
            text-underline-offset: 0.4ex;
        }

        @media screen and (width <= 612px) {
            font-size: max(var(--base-font-size), 0.875em);
        }
    }
}

/* Stacked (the footer and the 404 page): one row while the links fit, folding
   to as many rows as it takes when they don't. No breakpoint — the content
   decides, so the same rule holds for three links or a dozen. */
:host([stacked]) ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: start;
    align-items: baseline;
    column-gap: calc(var(--content-space) * 2);
    row-gap: calc(var(--content-space) * 0.35);
}

/* Column (the hero's link stack and the footer groups): one link per line,
   folding back into a wrapped row on narrow screens where the column would
   otherwise push the page content down. */
:host([column]) {
    padding: 0;
    line-height: inherit;
}

:host([column]) ul {
    display: flex;
    flex-direction: column;
    align-items: start;
    justify-content: start;
    inline-size: auto;
    gap: calc(var(--content-space) * 0.35);

    @media screen and (width <= 768px) {
        flex-direction: row;
        flex-wrap: wrap;
        align-items: baseline;
        column-gap: calc(var(--content-space) * 1.25);
        row-gap: calc(var(--content-space) * 0.25);
    }
}

:host([column]) li {
    display: block;
}

/* A stack of plain links, not pills — no border, no background. */
:host([column]) a,
:host([column]) a:visited {
    margin: 0;
    padding-inline: var(--link-pad, 0);
    border: none;
    border-radius: 0;
    line-height: inherit;
    font-size: max(var(--base-font-size), 1em);
    color: inherit;

    &[aria-current="page"] {
        padding-inline: var(--link-pad, 0);
        background: none;
        color: var(--color-accent-text);
    }
}

/* The hero menu: the current page is a filled pill, so it reads as "you are
   here" without relying on an underline. Links are 44px targets. Flat
   selectors: webc:scoped does not rewrite a nested `&` under `:host()`. */
:host([data-context="hero"][column]) {
    --link-pad: 0.85em;
}

:host([data-context="hero"][column]) a[href] {
    border-radius: var(--radius-pill);
}

:host([data-context="hero"][column]) a[href][aria-current="page"] {
    background-color: var(--color-accent-secondary);
    color: var(--color-on-accent-secondary);
    text-decoration: none;
    font-weight: var(--font-weight--semi-bold);
    --color-focus-ring: var(--color-on-accent-secondary);
}

:host([data-context="hero"][column]) a[href]:not([aria-current="page"]):hover {
    background-color: color-mix(in oklab, var(--color-accent-secondary) 10%, transparent);
}

@media (forced-colors: active) {
    :host([data-context="hero"][column]) a[href][aria-current="page"] {
        forced-color-adjust: none;
        background: SelectedItem;
        color: SelectedItemText;
    }
}
</style>
