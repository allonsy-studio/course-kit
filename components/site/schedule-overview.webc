<script webc:setup>
	/**
	 * The schedule page's header: the meeting line, the key dates, and a row
	 * of jump links (Today, then one per month). Props are read in the
	 * template, since a setup script cannot see them.
	 * @prop {{ title: string, items: object[] }[]} [groups] `scheduleKeyDates`
	 *   output; built from the page's lessons, project and exam slot when left out
	 * @prop {object[]} [weeks] `scheduleWeeks` output, for the month links;
	 *   built from the page when left out
	 */
	const defaultGroups = scheduleKeyDates($data.lessons, $data.project, $data.schedule?.finalExam, $data.copy);
	const defaultWeeks = scheduleWeeks($data.lessons, $data.schedule?.weeks, $data.collections?.deck, $data.demos);
</script>
<header webc:root="override" class="schedule-overview">
	<today-marker></today-marker>
	<eyebrow class="separators">
		<span @text="$data.term.label"></span>
		<span @text="$data.course.code"></span>
	</eyebrow>
	<h1 @text="$data.copy.scheduleOverview.schedule"></h1>
	<p class="meets" webc:if="$data.schedule?.meetings?.days?.length">
		<span @text="$data.schedule.meetings.days.length > 1 ? `${$data.schedule.meetings.days.slice(0, -1).join(', ')} & ${$data.schedule.meetings.days.at(-1)}` : $data.schedule.meetings.days[0]"></span>
		<span webc:if="$data.schedule.meetings.time" @text="$data.schedule.meetings.time"></span>
		<span webc:if="$data.instructor?.office" @text="$data.instructor.office"></span>
	</p>

	<section class="key-dates" aria-labelledby="schedule-key-dates" webc:if="(groups ?? defaultGroups)?.length">
		<h2 id="schedule-key-dates" @text="$data.copy.scheduleOverview.keyDates"></h2>
		<div class="group" webc:for="group of (groups ?? defaultGroups)">
			<h3 @text="group.title"></h3>
			<ul role="list">
				<li webc:for="item of group.items">
					<strong @text="item.label"></strong>
					<span class="when" @text="item.date"></span>
					<span class="note" webc:if="item.note" @text="item.note"></span>
				</li>
			</ul>
		</div>
	</section>

	<nav class="schedule-jump" :aria-label="$data.copy.scheduleOverview.jumpTo" webc:if="scheduleMonths(weeks ?? defaultWeeks).length">
		<h2 @text="$data.copy.scheduleOverview.jumpTo"></h2>
		<ul role="list">
			<li><today-link :@label="$data.copy.schedule.today"></today-link></li>
			<li webc:for="entry of scheduleMonths(weeks ?? defaultWeeks)"><a :href="`#week-${entry.week}`" @text="entry.name"></a></li>
		</ul>
	</nav>
</header>

<style webc:scoped>
	/* The page header: key dates as stacked groups of label/date rows (they
	   wrap, so nothing scrolls sideways on a phone) and a "Jump to" row of
	   tap-sized links (Today, then one per month). */
	:host > :where(.meets) {
		max-inline-size: 70ch;
	}

	.meets {
		display: flex;
		flex-wrap: wrap;
		gap: 0 1em;
		color: var(--color-text-muted);
	}

	.key-dates {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 18em), 1fr));
		gap: var(--content-space) calc(var(--content-space) * 1.5);
		max-inline-size: none;

		> h2 {
			grid-column: 1 / -1;
			margin-block-end: 0;
		}

		/* A group's name is a label for the rows under it, in the text face. */
		h3 {
			margin-block: 0 0.25em;
			font-family: var(--sans-font);
			font-size: var(--font-size-6);
			font-weight: var(--font-weight--semi-bold);
			letter-spacing: 0.06em;
			text-transform: uppercase;
			color: var(--color-text-muted);
		}

		ul {
			list-style: none;
			margin: 0;
			padding: 0;
		}

		li {
			display: flex;
			flex-direction: column;
			padding-block: 0.4em;
			border-block-start: var(--thin-border-width) solid var(--color-border);
		}

		.when,
		.note {
			color: var(--color-text-muted);
		}

		.note {
			font-size: max(var(--base-font-size), 0.9em);
			font-style: italic;
		}
	}

	.schedule-jump {
		ul {
			display: flex;
			flex-wrap: wrap;
			gap: 0.4rem;
			list-style: none;
			margin: 0;
			padding: 0;
		}

		a {
			display: flex;
			align-items: center;
			justify-content: center;
			min-block-size: 2.75rem;
			min-inline-size: 2.75rem;
			padding-inline: 1em;
			border: var(--thin-border-width) solid var(--color-border);
			border-radius: var(--standard-border-radius);
			font-weight: var(--font-weight--semi-bold);
			text-decoration: none;

			&:is(:hover, :focus-visible) {
				background-color: var(--color-surface);
				border-color: var(--color-accent);
			}
		}
	}

	@media print {
		.schedule-jump {
			display: none;
		}
	}
</style>
