<script webc:setup>
	/**
	 * The schedule page's header: the meeting line, the key dates, and a sticky
	 * row of one jump link per month, with the Hide past weeks toggle at its
	 * end. The month on screen is marked as the page scrolls. The row is
	 * sticky from 40em wide and static below it, where it would take too much
	 * of a phone's height. Props are read in the template, since a setup script
	 * cannot see them.
	 * @prop {{ title: string, items: object[] }[]} [groups] `scheduleKeyDates`
	 *   output; built from the page's lessons, project and exam slot when left out
	 * @prop {object[]} [weeks] `scheduleWeeks` output, for the month links;
	 *   built from the page when left out
	 * @prop {'short' | 'full'} [dateStyle] how the key dates write a project
	 *   milestone's and the final exam's date: `full` (the default, "Friday,
	 *   October 23, 2026, 12:00PM") or `short` ("Fri, Oct 23, 12:00PM"). Written
	 *   `@date-style`
	 */
	const defaultGroups = scheduleKeyDates($data.lessons, $data.project, $data.schedule?.finalExam, $data.copy);
	/** The key dates for a date style; the setup script cannot see props, so the template calls this with its own. */
	const groupsFor = (style) => (style === "short" ? scheduleKeyDates($data.lessons, $data.project, $data.schedule?.finalExam, $data.copy, "short") : defaultGroups);
	const defaultWeeks = scheduleWeeks($data.lessons, $data.schedule?.weeks, $data.collections?.deck, $data.demos);
</script>
<header webc:root="override" class="schedule-overview">
	<today-marker></today-marker>
	<h1 @text="$data.copy.scheduleOverview.schedule"></h1>
	<p class="meets" webc:if="$data.schedule?.meetings?.days?.length">
		<span @text="$data.schedule.meetings.days.length > 1 ? `${$data.schedule.meetings.days.slice(0, -1).join(', ')} & ${$data.schedule.meetings.days.at(-1)}` : $data.schedule.meetings.days[0]"></span>
		<span webc:if="$data.schedule.meetings.time" @text="$data.schedule.meetings.time"></span>
		<span webc:if="$data.instructor?.office" @text="$data.instructor.office"></span>
	</p>

	<section class="key-dates" aria-labelledby="schedule-key-dates" webc:if="(groups ?? groupsFor(typeof dateStyle === 'undefined' ? undefined : dateStyle))?.length">
		<h2 id="schedule-key-dates" @text="$data.copy.scheduleOverview.keyDates"></h2>
		<div class="group" webc:for="group of (groups ?? groupsFor(typeof dateStyle === 'undefined' ? undefined : dateStyle))">
			<h3 @text="group.title"></h3>
			<ul role="list">
				<li webc:for="item of group.items">
					<strong @text="item.label"></strong>
					<span class="when" @text="item.date"></span>
					<span class="note" webc:if="item.note" @text="item.note"></span>
				</li>
			</ul>
		</div>
	</section>

	<div class="schedule-bar" data-schedule-bar webc:if="scheduleMonths(weeks ?? defaultWeeks).length">
		<nav class="schedule-jump" :aria-label="$data.copy.scheduleOverview.jumpTo">
			<h2 @text="$data.copy.scheduleOverview.jumpTo"></h2>
			<ul role="list">
				<li webc:for="entry of scheduleMonths(weeks ?? defaultWeeks)"><a :href="`#week-${entry.week}`" :data-first-week="entry.week" :data-last-week="entry.last" @text="entry.name"></a></li>
			</ul>
		</nav>
		<div class="schedule-toggle" data-schedule-tools hidden>
			<p class="schedule-status" data-schedule-status role="status"></p>
			<button type="button" class="hide-past" data-hide-past aria-pressed="false" @text="$data.copy.schedule.hidePast"></button>
		</div>
	</div>
</header>

<style webc:scoped>
	/* The page header: key dates as stacked groups of label/date rows (they
	   wrap, so nothing scrolls sideways on a phone) and a "Jump to" row of
	   tap-sized links (Today, then one per month). */
	:host > :where(.meets) {
		max-inline-size: 70ch;
	}

	.meets {
		display: flex;
		flex-wrap: wrap;
		gap: 0 1em;
		color: var(--color-text-muted);
	}

	.key-dates {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 18em), 1fr));
		gap: var(--content-space) calc(var(--content-space) * 1.5);
		max-inline-size: none;

		> h2 {
			grid-column: 1 / -1;
			margin-block-end: 0;
		}

		/* A group's name is a label for the rows under it, in the text face. */
		h3 {
			margin-block: 0 0.25em;
			font-family: var(--sans-font);
			font-size: var(--font-size-6);
			font-weight: var(--font-weight--semi-bold);
			letter-spacing: 0.06em;
			text-transform: uppercase;
			color: var(--color-text-muted);
		}

		ul {
			list-style: none;
			margin: 0;
			padding: 0;
		}

		li {
			display: flex;
			flex-direction: column;
			padding-block: 0.4em;
			border-block-start: var(--thin-border-width) solid var(--color-border);
		}

		.when,
		.note {
			color: var(--color-text-muted);
		}

		.note {
			font-size: max(var(--base-font-size), 0.9em);
			font-style: italic;
		}
	}

	/* The row of month links and the toggle. From 40em it is sticky, pinned to the top of the page through the weeks: the header's own box is
	   dropped (`display: contents`) so the row's containing block is the whole page column, and the page's scroll-padding follows the row's height
	   (set by the script) so an anchor or a focused control is never under it. Below 40em it is a plain row, because on a phone it would take a
	   quarter of the screen. */
	.schedule-bar {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.25rem var(--content-space);
		margin-block: var(--content-space);

		@media screen and (width >= 40em) {
			position: sticky;
			inset-block-start: 0;
			z-index: 10;
			margin-block: 0;
			padding-block: 0.4rem;
			background-color: var(--color-page);
			border-block-end: var(--thin-border-width) solid var(--color-border-strong);
		}
	}

	@media screen and (width >= 40em) {
		:host {
			display: contents;
		}

		:host > .schedule-bar + * {
			margin-block-start: var(--content-space);
		}
	}

	/* Space between the label and the month links, beside them or, when the row wraps, above them. */
	.schedule-jump {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem calc(var(--content-space) * 1.5);
		min-inline-size: 0;

		h2 {
			margin: 0;
			font-family: var(--sans-font);
			font-size: var(--font-size-6);
			font-weight: var(--font-weight--semi-bold);
			letter-spacing: 0.08em;
			text-transform: uppercase;
			color: var(--color-text-muted);
		}

		ul {
			display: flex;
			flex-wrap: wrap;
			gap: 0.4rem;
			list-style: none;
			margin: 0;
			padding: 0;
		}

		a {
			display: flex;
			align-items: center;
			justify-content: center;
			min-block-size: 2.75rem;
			min-inline-size: 2.75rem;
			padding-inline: 1em;
			border: var(--thin-border-width) solid var(--color-border);
			border-radius: var(--standard-border-radius);
			font-weight: var(--font-weight--semi-bold);
			text-decoration: none;

			&:is(:hover, :focus-visible) {
				background-color: var(--color-surface);
				border-color: var(--color-accent);
			}

			/* The month on screen, set by the script as the page scrolls: a thick underline in the location accent. A shape, not a color alone, and
			   it changes no size, so nothing moves when the mark does. */
			&[aria-current] {
				text-decoration: underline;
				text-decoration-color: var(--color-accent-secondary);
				text-decoration-thickness: 0.2em;
				text-underline-offset: 0.3em;
			}
		}
	}

	.schedule-toggle {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.25rem var(--content-space);

		&[hidden] {
			display: none;
		}
	}

	/* The count beside the button when there is room; below 48em it is hidden from sight and still announced (role="status"). */
	.schedule-status {
		margin: 0;
		color: var(--color-text-muted);

		@media screen and (width < 48em) {
			position: absolute;
			inline-size: 1px;
			block-size: 1px;
			overflow: hidden;
			clip-path: inset(50%);
			white-space: nowrap;
		}
	}

	/* A switch, not a button: a quiet label after a small track whose knob and fill say on or off, so it reads as a setting beside the month
	   links rather than outranking them. The state is aria-pressed; the whole row is the 44px target. The track's edge holds 3:1. */
	.hide-past {
		display: inline-flex;
		align-items: center;
		gap: 0.6em;
		min-block-size: var(--target-min);
		padding-inline: 0.25em;
		border: 0;
		border-radius: var(--standard-border-radius);
		background: transparent;
		color: var(--color-text-muted);
		font: inherit;
		font-size: max(var(--base-font-size), 0.95em);
		cursor: pointer;

		&::before {
			content: "";
			flex: none;
			inline-size: 2.25em;
			block-size: 1.25em;
			box-sizing: border-box;
			border: var(--thin-border-width) solid var(--color-border-strong);
			border-radius: var(--radius-pill);
			background:
				radial-gradient(circle closest-side, var(--color-text-muted) 70%, transparent 76%) left 0.15em center / 0.95em 0.95em no-repeat,
				var(--color-page);
		}

		&:is(:hover, :focus-visible) {
			color: var(--color-text);
		}

		&[aria-pressed="true"] {
			color: var(--color-text);

			&::before {
				border-color: var(--color-accent-secondary);
				background:
					radial-gradient(circle closest-side, var(--color-on-accent-secondary) 70%, transparent 76%) right 0.15em center / 0.95em 0.95em no-repeat,
					var(--color-accent-secondary);
			}
		}

		@media (prefers-reduced-motion: no-preference) {
			&::before {
				transition: background-position 150ms ease-out, background-color 150ms ease-out;
			}
		}
	}

	@media (forced-colors: active) {
		.schedule-bar {
			border-block-end-color: CanvasText;
		}

		.schedule-jump a[aria-current] {
			text-decoration-color: Highlight;
		}

		.hide-past::before {
			forced-color-adjust: none;
			border-color: ButtonText;
			background: radial-gradient(circle closest-side, ButtonText 70%, transparent 76%) left 0.15em center / 0.95em 0.95em no-repeat, Canvas;
		}

		.hide-past[aria-pressed="true"]::before {
			border-color: Highlight;
			background: radial-gradient(circle closest-side, HighlightText 70%, transparent 76%) right 0.15em center / 0.95em 0.95em no-repeat, Highlight;
		}
	}

	@media print {
		.schedule-bar {
			display: none;
		}
	}
</style>

<style>
	/* The page scrolls under the sticky row: anchors and focused controls stop below it (WCAG 2.4.11, 2.4.12). The script sets the height. */
	html:has(.schedule-bar) {
		scroll-padding-block-start: calc(var(--schedule-bar-height, 0px) + 1rem);
	}
</style>

<script>
	/**
	 * Marks the month on screen in the row with `aria-current="location"`: the month of the last week block whose top has reached the line where an
	 * anchor lands it, below the row; before the first week reaches it the first month, at the foot of the page the last month. Sets `--schedule-bar-height`
	 * for the page's scroll-padding while the row is sticky. It changes no size and runs no animation.
	 */
	(() => {
		const bar = document.querySelector("[data-schedule-bar]");
		if (!bar || !bar.getClientRects().length) return;
		const links = [...bar.querySelectorAll("a[data-first-week]")];
		const weeks = [...document.querySelectorAll(".schedule-weeks .week[id^='week-']")];
		if (!links.length || !weeks.length) return;
		const range = links.map((link) => ({ link, first: Number(link.dataset.firstWeek), last: Number(link.dataset.lastWeek) }));
		/** The month of a week: the latest month whose range holds it, so a week spanning two months reads as the second, where its link points. */
		const monthOf = (number) => range.findLast(({ first, last }) => number >= first && number <= last) ?? range.at(-1);
		const mark = () => {
			const shown = weeks.filter((week) => !week.hidden);
			if (!shown.length) return;
			// Where an anchor lands a week's top: below the row, by the page's scroll-padding and the week's scroll-margin. The week is on screen once its top is at or above that line.
			const line = (Number.parseFloat(getComputedStyle(document.documentElement).scrollPaddingTop) || 0) + (Number.parseFloat(getComputedStyle(shown[0]).scrollMarginTop) || 0) + 1;
			// The last week whose top has reached the line, or the first week before any has.
			const week = shown.findLast((candidate) => candidate.getBoundingClientRect().top <= line) ?? shown[0];
			// A page scrolled to its foot can leave the last week below the line: then the last month is the one on screen.
			const bottomed = window.scrollY > 0 && window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 2;
			const current = week && !bottomed ? monthOf(Number(week.id.slice(5))) : range.at(-1);
			for (const { link } of range) {
				if (link === current.link) link.setAttribute("aria-current", "location");
				else link.removeAttribute("aria-current");
			}
		};
		const measure = () => document.documentElement.style.setProperty("--schedule-bar-height", getComputedStyle(bar).position === "sticky" ? `${Math.ceil(bar.getBoundingClientRect().height)}px` : "0px");
		let queued = false;
		addEventListener("scroll", () => {
			if (queued) return;
			queued = true;
			requestAnimationFrame(() => {
				queued = false;
				mark();
			});
		}, { passive: true });
		new ResizeObserver(() => {
			measure();
			mark();
		}).observe(bar);
		measure();
		mark();
	})();
</script>
