<script webc:setup>
	/**
	 * The grade-weighting table.
	 * @prop {object} grading category weights, keyed by name
	 */
</script>
<div webc:root="override">
    <table>
        <caption>Grade weighting</caption>
        <thead>
            <tr><th scope="col">Category</th><th scope="col">Weight</th></tr>
        </thead>
        <tbody>
            <tr webc:for="entry of Object.entries(grading).filter(([key]) => key !== '$schema')">
                <td @text="entry[1].title"></td>
                <td @text="entry[1].weight"></td>
            </tr>
        </tbody>
    </table>
    <table>
        <caption>Grading scale</caption>
        <thead>
            <tr><th scope="col">Grade</th><th scope="col">Weighted average</th></tr>
        </thead>
        <tbody>
            <tr webc:for="(letter, range) in $data.scale">
                <td @text="letter"></td>
                <td>
                    <span webc:if="range.min != null" @text="`${range.min} and above`"></span>
                    <span webc:else @text="`below ${range.max}`"></span>
                </td>
            </tr>
        </tbody>
    </table>
</div>

<style webc:scoped>
	:host {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 18em), 1fr));
		gap: calc(var(--content-space, 1rem) * 2);
		align-items: start;

		caption {
			text-align: start;
			font-weight: var(--font-weight--semi-bold);
			padding-block-end: calc(var(--content-space, 1rem) / 2);
		}
	}
</style>
