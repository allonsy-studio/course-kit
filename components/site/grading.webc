<script webc:setup>
	/**
	 * The grade-weighting table and the grading scale. Reads the `grading` and
	 * `scale` data; it takes no props and renders nothing without `grading`.
	 */
</script>
<div webc:root="override" webc:if="$data.grading">
    <table>
        <caption>Grade weighting</caption>
        <thead>
            <tr><th scope="col">Category</th><th scope="col">Weight</th></tr>
        </thead>
        <tbody>
            <tr webc:for="entry of Object.entries($data.grading).filter(([key]) => key !== '$schema')">
                <td @text="entry[1].title"></td>
                <td @text="entry[1].weight"></td>
            </tr>
        </tbody>
    </table>
    <table>
        <caption>Grading scale</caption>
        <thead>
            <tr><th scope="col">Grade</th><th scope="col">Weighted average</th></tr>
        </thead>
        <tbody>
            <tr webc:for="band of Object.entries($data.scale ?? {}).filter(([key]) => key !== '$schema')">
                <td @text="band[0]"></td>
                <td>
                    <span webc:if="band[1].min != null" @text="`${band[1].min} and above`"></span>
                    <span webc:else @text="`below ${band[1].max}`"></span>
                </td>
            </tr>
        </tbody>
    </table>
</div>

<style webc:scoped>
	:host {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 18em), 1fr));
		gap: calc(var(--content-space, 1rem) * 2);
		align-items: start;

		caption {
			text-align: start;
			font-weight: var(--font-weight--semi-bold);
			padding-block-end: calc(var(--content-space, 1rem) / 2);
		}
	}
</style>
