<script webc:setup>
	/**
	 * The course glossary page: every `vocab` and `api` slide as one tagged
	 * term, listed A to Z for readers without scripts and enhanced into
	 * Review and Flashcards by `<glossary-panel>`.
	 * Reads the `glossary` global.
	 */
</script>
<article class="content-column glossary" id="glossary" webc:if="$data.glossary?.terms?.length">
	<header>
		<eyebrow class="separators">
			<span @text="$data.term.label"></span>
			<span @text="$data.course.code"></span>
			<span @text="$data.copy.glossary.glossary"></span>
		</eyebrow>
		<h1 @text="$data.copy.glossary.courseGlossary"></h1>
		<p class="intro">
			<strong @text="$data.glossary.terms.length"></strong>
			<span @text="fill($data.copy.glossary.termsFromClassEach, { reading: $data.glossary.readingLabel.toLowerCase() })"></span>
		</p>
	</header>

	<glossary-panel :@json="$data.glossary.json">
		<div data-static>
			<section class="group" webc:for="group of $data.glossary.az" :id="`g-az-${group.key}`" :aria-labelledby="`g-az-${group.key}-h`">
				<h2 class="heading" :id="`g-az-${group.key}-h`">
					<span class="name" @text="group.label"></span>
					<span class="aside">
						<span class="count" @text="fill(plural($data.copy.glossary, 'terms', group.terms.length, $data.site.language), { count: group.terms.length })"></span>
					</span>
				</h2>
				<dl>
					<glossary-entry webc:for="item of group.terms" :@entry="item"></glossary-entry>
				</dl>
			</section>
		</div>
	</glossary-panel>
</article>

<style webc:scoped>
	.intro {
		color: var(--color-text-muted);
		margin-block: 0;
	}
</style>
