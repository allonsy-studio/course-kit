<script webc:setup>
	/**
	 * Where the course is now, for the home page: the current or next class,
	 * what is due soon, and a week-by-week track of the term. Built from the
	 * schedule, not from anything a student has done. The script fills it in
	 * by campus date; without it the section stays hidden.
	 * @prop {string} [schedule="/schedule/"] the schedule page's URL, which the links point at
	 */
	const nowWeeks = scheduleWeeks($data.lessons, $data.schedule?.weeks, $data.collections?.deck, $data.demos);
	const plain = (html) => String(html ?? "").replace(/<[^>]+>/g, "").trim();
	/** The meetings the script reads, as the JSON in `data-weeks`: dates, plain-text topics and due items. */
	const nowData = JSON.stringify(
			(nowWeeks ?? []).map((week) => ({
				week: week.week,
				dates: week.dates,
				meetings: week.meetings.map((meeting) => ({
					iso: meeting.iso,
					display: meeting.display,
					noClass: Boolean(meeting.noClass),
					topics: (meeting.topics ?? []).map(plain),
					due: (meeting.due ?? []).map((item) => ({ title: item.title, href: item.href, dueLabel: item.dueLabel })),
				})),
			})),
		);
</script>
<section webc:root="override" class="course-now" data-course-now hidden aria-labelledby="course-now-heading" :data-schedule="schedule ?? '/schedule/'" :data-weeks="nowData" webc:if="nowWeeks?.length">
	<div class="now-row">
		<div class="next-class" data-next hidden>
			<p class="now-label" data-next-label>Pick up where you left off</p>
			<p class="next-when" data-next-when></p>
			<h2 id="course-now-heading" data-next-title></h2>
			<ul class="next-topics" role="list" data-next-topics></ul>
			<a class="next-link" data-next-link :href="schedule ?? '/schedule/'">Open this class on the schedule</a>
		</div>
		<div class="coming-up" data-coming hidden>
			<h2>Coming up</h2>
			<ul role="list" data-coming-list></ul>
			<a :href="schedule ?? '/schedule/'">Full schedule</a>
		</div>
	</div>
	<div class="track">
		<p class="now-label" id="course-now-track">Term progress <span class="track-count" data-track-count></span></p>
		<ol role="list" aria-labelledby="course-now-track">
			<li webc:for="week of nowWeeks" :data-week-number="week.week">
				<a :href="`${schedule ?? '/schedule/'}#week-${week.week}`">
					<span class="bar" aria-hidden="true"></span>
					<span class="name">Week <span @text="week.week"></span></span>
					<span class="state" data-state-text>Upcoming</span>
				</a>
			</li>
		</ol>
	</div>
</section>

<script>
	/**
	 * <course-now>: pick the current or next class by campus date, list the
	 * next due items, and mark each week of the track done, now or upcoming.
	 */
	(() => {
		try {
			const today = new Date().toLocaleDateString("en-CA", { timeZone: document.documentElement.dataset.timezone || undefined });
			for (const host of document.querySelectorAll("[data-course-now]")) {
				const weeks = JSON.parse(host.dataset.weeks);
				const meetings = weeks.flatMap((week) => week.meetings.map((meeting) => ({ ...meeting, week: week.week })));
				if (!meetings.length) continue;
				const schedule = host.dataset.schedule;

				const next = meetings.find((meeting) => !meeting.noClass && meeting.iso >= today);
				if (next) {
					const box = host.querySelector("[data-next]");
					if (next.iso !== today) box.querySelector("[data-next-label]").textContent = "Next class";
					box.querySelector("[data-next-when]").textContent = `Week ${next.week}`;
					box.querySelector("[data-next-title]").textContent = next.iso === today ? `Today, ${next.display}` : next.display;
					const topics = box.querySelector("[data-next-topics]");
					for (const topic of next.topics.slice(0, 3)) topics.append(Object.assign(document.createElement("li"), { textContent: topic }));
					box.querySelector("[data-next-link]").href = `${schedule}#week-${next.week}`;
					box.hidden = false;
				}

				const due = meetings.filter((meeting) => meeting.iso >= today).flatMap((meeting) => meeting.due.map((item) => ({ ...item, week: meeting.week }))).slice(0, 3);
				if (due.length) {
					const list = host.querySelector("[data-coming-list]");
					for (const item of due) {
						const li = document.createElement("li");
						const title = Object.assign(document.createElement(item.href ? "a" : "span"), { textContent: item.title });
						if (item.href) title.href = item.href;
						title.className = "due-title";
						li.append(title);
						if (item.dueLabel) li.append(Object.assign(document.createElement("span"), { className: "due-when", textContent: item.dueLabel }));
						list.append(li);
					}
					host.querySelector("[data-coming]").hidden = false;
				}

				const currentWeek = (weeks.find((week) => week.meetings.some((meeting) => meeting.iso >= today)) ?? {}).week;
				let done = 0;
				for (const li of host.querySelectorAll("[data-week-number]")) {
					const number = Number(li.dataset.weekNumber);
					const state = number === currentWeek ? "now" : currentWeek === undefined || number < currentWeek ? "done" : "";
					if (!state) continue;
					if (state === "done") done += 1;
					li.dataset.week = state;
					li.querySelector("[data-state-text]").textContent = state === "now" ? "Now" : "Done";
					if (state === "now") li.querySelector("a").setAttribute("aria-current", "step");
				}
				host.querySelector("[data-track-count]").textContent = `${done} of ${weeks.length} weeks done`;
				host.hidden = false;
			}
		} catch {
			// Never let the home panel break the scripts bundled after it.
		}
	})();
</script>

<style webc:scoped>
	:host {
		display: grid;
		gap: var(--section-space);
		padding-block: var(--section-space);

		&[hidden] {
			display: none;
		}

		@media print {
			display: none;
		}
	}

	.now-row {
		display: grid;
		grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
		gap: var(--content-space);

		@media screen and (width <= 800px) {
			grid-template-columns: minmax(0, 1fr);
		}
	}

	.now-label {
		margin: 0;
		font-size: var(--font-size-6);
		font-weight: var(--font-weight--medium);
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	/* The one accent block on the page: the class to open next. */
	.next-class {
		display: grid;
		align-content: start;
		gap: 0.5em;
		padding: calc(var(--content-space) * 2);
		border-radius: calc(var(--standard-border-radius) * 5);
		background-color: var(--color-accent);
		color: var(--color-on-accent);

		&[hidden] {
			display: none;
		}

		h2 {
			margin: 0;
			color: inherit;
			font-size: var(--font-size-2);
		}

		p {
			margin: 0;
		}

		.next-topics {
			margin: 0;
			padding: 0;
			list-style: none;
		}

		.next-link {
			justify-self: start;
			display: inline-grid;
			place-items: center;
			min-block-size: 2.75rem;
			margin-block-start: 0.5em;
			padding-inline: 1.4em;
			border-radius: 9999px;
			background-color: var(--color-on-accent);
			color: var(--color-accent);
			font-weight: var(--font-weight--bold);
			text-decoration: none;

			&:is(:hover, :focus-visible) {
				text-decoration: underline;
			}

			&:focus-visible {
				outline-color: var(--color-on-accent);
			}
		}
	}

	.coming-up {
		display: grid;
		align-content: start;
		gap: 0.6em;
		padding: calc(var(--content-space) * 1.5);
		border: var(--thin-border-width) solid var(--color-border);
		border-radius: calc(var(--standard-border-radius) * 5);
		background-color: var(--color-surface);

		&[hidden] {
			display: none;
		}

		h2 {
			margin: 0;
			font-size: var(--font-size-4);
		}

		ul {
			display: grid;
			gap: 0.5em;
			margin: 0;
			padding: 0;
			list-style: none;
		}

		li {
			display: grid;
			padding: 0.6em 0.8em;
			border: var(--thin-border-width) solid var(--color-text-muted);
			border-radius: calc(var(--standard-border-radius) * 3);
			background-color: var(--color-page);
		}

		.due-title {
			font-weight: var(--font-weight--semi-bold);
		}

		.due-when {
			color: var(--color-text-muted);
			font-size: max(var(--base-font-size), 0.9em);
		}
	}

	.track {
		display: grid;
		gap: 0.6em;

		.track-count {
			margin-inline-start: 0.6em;
			color: var(--color-text-muted);
			letter-spacing: 0;
			text-transform: none;
		}

		ol {
			display: grid;
			grid-template-columns: repeat(auto-fill, minmax(5.5rem, 1fr));
			gap: 0.5em;
			margin: 0;
			padding: 0;
			list-style: none;
		}

		a {
			display: grid;
			gap: 0.35em;
			padding-block: 0.25em;
			color: var(--color-text);
			text-decoration: none;

			&:is(:hover, :focus-visible) .name {
				text-decoration: underline;
			}
		}

		.bar {
			block-size: 0.6em;
			border-radius: 9999px;
			background-color: var(--color-border);
		}

		.name {
			font-weight: var(--font-weight--semi-bold);
			font-size: max(var(--base-font-size), 0.9em);
		}

		.state {
			color: var(--color-text-muted);
			font-size: max(var(--base-font-size), 0.9em);
		}

		[data-week="done"] .bar {
			background-color: var(--color-text);
		}

		[data-week="now"] .bar {
			background-color: var(--color-accent-secondary);
			outline: var(--border-width) solid var(--color-accent-secondary);
			outline-offset: 2px;
		}
	}
</style>
