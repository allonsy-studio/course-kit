<script webc:setup>
	/**
	 * The instructor's details: photo, office, contact and hours. Reads `instructor`.
	 * @prop {'card'} [variant] a compact card instead of the full section
	 * @prop {'icons'} [contactLinks] show the email, the message link and the blog as icon links in the corner of the panel instead of rows in the fact list; the same as `contactLinks: "icons"` in `instructor.json`, and wins over it
	 */
	/** The prop wins over the data; either one set to "icons" turns the icon links on. */
	const iconsOn = (data, prop) => (prop ?? data.instructor?.contactLinks) === "icons";
	const host = (url) => url.replace(/^https?:\/\//, "").replace(/\/$/, "");
</script>
<section id="instructor" aria-labelledby="instructor-heading" webc:root="override" webc:if="$data.instructor">
    <template webc:nokeep webc:for="icons of [iconsOn($data, typeof contactLinks === 'undefined' ? undefined : contactLinks)]" webc:if="variant !== 'card'">
        <div class="who">
            <img class="photo screen-only" webc:if="$data.instructor.photo" :src="$data.instructor.photo" :alt="$data.instructor.name" width="160" height="160">
            <div class="facts-column">
                <h2 id="instructor-heading" @text="$data.copy.instructor.yourInstructor"></h2>
                <dl class="facts">
                    <div class="name">
                        <dt class="sr-only" @text="$data.copy.instructor.name"></dt>
                        <dd><strong><span webc:if="!$data.instructor.profile" @text="$data.instructor.name"></span><a
                            webc:if="$data.instructor.profile" :href="$data.instructor.profile" @text="$data.instructor.name"></a></strong></dd>
                    </div>
                    <div webc:if="$data.instructor.office">
                        <dt @text="$data.copy.instructor.office"></dt>
                        <dd @text="$data.instructor.office"></dd>
                    </div>
                    <div webc:if="$data.instructor.hours?.length">
                        <dt @text="$data.copy.instructor.officeHours"></dt>
                        <dd>
                            <ul role="list">
                                <li webc:for="block of $data.instructor.hours" @text="block"></li>
                            </ul>
                        </dd>
                    </div>
                    <div webc:if="!icons && $data.instructor.email" :class="$data.instructor.contact ? 'print-only' : ''">
                        <dt @text="$data.copy.instructor.email"></dt>
                        <dd><a :data-email="encodeEmail($data.instructor.email)"></a></dd>
                    </div>
                    <div webc:if="!icons && $data.instructor.contact" :class="$data.instructor.email ? 'screen-only' : ''">
                        <dt @text="$data.copy.instructor.message"></dt>
                        <dd><a :href="$data.instructor.contact" @text="$data.copy.instructor.sendMeAMessage"></a></dd>
                    </div>
                    <div webc:if="!icons && $data.instructor.blog">
                        <dt @text="$data.copy.instructor.blog"></dt>
                        <dd><a :href="$data.instructor.blog" @text="$data.instructor.blog.replace(/^https?:\/\//, '').replace(/\/$/, '')"></a></dd>
                    </div>
                </dl>
                <p class="muted note" webc:if="$data.instructor.note" @text="$data.instructor.note"></p><ul class="links" role="list" :aria-label="$data.copy.instructor.contact" webc:if="icons && ($data.instructor.email || $data.instructor.contact || $data.instructor.blog)">
                    <li webc:if="$data.instructor.email">
                        <a class="icon-link" :data-email="encodeEmail($data.instructor.email)" :aria-label="$data.copy.instructor.email" :title="$data.copy.instructor.email"><svg
                            aria-hidden="true" focusable="false" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="m3 7 9 6 9-6"></path></svg><span
                            class="link-text" data-email-text></span></a>
                    </li>
                    <li webc:if="$data.instructor.contact" :class="$data.instructor.email ? 'screen-only' : ''">
                        <a class="icon-link" :href="$data.instructor.contact" :aria-label="$data.copy.instructor.sendMeAMessage" :title="$data.copy.instructor.sendMeAMessage"><svg
                            aria-hidden="true" focusable="false" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.6A8 8 0 1 1 21 12z"></path></svg><span
                            class="link-text" @text="$data.copy.instructor.sendMeAMessage"></span></a>
                    </li>
                    <li webc:if="$data.instructor.blog">
                        <a class="icon-link" :href="$data.instructor.blog" :aria-label="$data.copy.instructor.blog" :title="fill($data.copy.instructor.blogUrl, { url: host($data.instructor.blog) })"><svg
                            aria-hidden="true" focusable="false" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"></circle><path d="M3 12h18"></path><path d="M12 3a14 14 0 0 1 0 18a14 14 0 0 1 0-18"></path></svg><span
                            class="link-text" @text="host($data.instructor.blog)"></span></a>
                    </li>
                </ul>
            </div>
        </div>
    </template>

    <template webc:nokeep webc:if="variant === 'card'">
        <div class="instructor-card">
            <img class="photo" webc:if="$data.instructor.photo" :src="$data.instructor.photo" :alt="$data.instructor.name" width="160" height="160">
            <p class="monogram" aria-hidden="true" webc:if="!$data.instructor.photo" @text="$data.instructor.name.split(' ').filter(Boolean).map((part) => part[0]).join('')"></p>
            <div>
                <h2 id="instructor-heading" class="instructor-name"><span
                    webc:if="!$data.instructor.profile" @text="$data.instructor.name"></span><a
                    webc:if="$data.instructor.profile" :href="$data.instructor.profile" @text="$data.instructor.name"></a></h2>
                <p class="instructor-meta separators">
                    <span @text="$data.copy.instructor.instructor"></span>
                    <span webc:if="$data.instructor.office" @text="$data.instructor.office"></span>
                    <span webc:if="$data.instructor.hours?.length" @text="$data.instructor.hours.join('; ')"></span>
                </p>
                <p class="instructor-contact" webc:if="$data.instructor.contact || $data.instructor.email || $data.instructor.blog">
                    <a webc:if="$data.instructor.contact" :href="$data.instructor.contact" :class="$data.instructor.email ? 'cta screen-only' : 'cta'" @text="$data.copy.instructor.sendMeAMessage"></a>
                    <a webc:if="$data.instructor.email" :data-email="encodeEmail($data.instructor.email)" :class="$data.instructor.contact ? 'print-only' : ''"></a>
                    <a webc:if="$data.instructor.blog" class="cta" :href="$data.instructor.blog" @text="$data.instructor.blog.replace(/^https?:\/\//, '').replace(/\/$/, '')"></a>
                </p>
                <p class="muted note" @text="$data.instructor.note" webc:if="$data.instructor.note"></p>
            </div>
        </div>
    </template>
</section>

<style webc:scoped>
    /* Default variant: the headshot beside a small labelled fact list — name,
       office, hours, email, blog, rather than a sentence, so each fact has a
       place a student can scan to. print.css collapses the same dl to one
       run-in line (its `#instructor dl` rules), so the markup serves both. */
    :host .who {
        display: flex;
        align-items: flex-start;
        gap: calc(var(--content-space) * 1.1);

        @media print {
            display: block;
        }
    }

    :host .facts-column {
        min-inline-size: 0;
        flex: 1 1 auto;
    }

    :host .facts-column h2 {
        margin-block: 0 0.35em;
        font-size: var(--font-size-6);
        font-weight: var(--font-weight--semi-bold);
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--color-text-muted);
    }

    :host .facts {
        display: grid;
        grid-template-columns: max-content minmax(0, 1fr);
        column-gap: var(--content-space);
        row-gap: 0.3em;
        margin: 0;

        > div {
            display: contents;
        }

        /* `display: contents` outranks the utility classes, so restate them
           for rows that appear on one medium only. */
        > div.print-only {
            display: none;
        }

        dt {
            color: var(--color-text-muted);
            font-size: var(--font-size-6);
            letter-spacing: 0.05em;
            text-transform: uppercase;
            line-height: var(--font-height);
            padding-block-start: 0.15em;
        }

        dd {
            margin: 0;
        }

        ul {
            list-style: none;
            margin: 0;
            padding: 0;
        }

        .name dd {
            grid-column: 1 / -1;
            font-size: var(--font-size-4);
            line-height: var(--font-height--dense);
            margin-block-end: 0.35em;
        }

        @media print {
            display: inline;
        }
    }

    :host .note {
        margin-block: 0.75em 0;
        font-size: max(var(--base-font-size), 0.9em);
    }

    :host .photo {
        flex: none;
        inline-size: 5.5em;
        block-size: 5.5em;
        border-radius: var(--circle-border-radius);
        object-fit: cover;
        border: var(--thin-border-width) solid var(--color-border);
    }

    :host .instructor-contact {
        margin-block: 0;
    }

    :host .instructor-card {
        display: flex;
        align-items: flex-start;
        gap: var(--content-space);
        max-inline-size: min(60ch, 100%);
        margin-inline: auto;
        padding: calc(var(--content-space) * 1.2);

        background-color: var(--color-surface);
        border: var(--thin-border-width) solid var(--color-border);
        border-radius: var(--standard-border-radius);
    }

    :host .instructor-card .photo {
        inline-size: 4em;
        block-size: 4em;
    }

    /* Initials rather than a photograph: it identifies the card at a glance
       without another asset to keep current. Decorative — the name is right
       beside it, so it stays out of the accessibility tree. */
    :host .monogram {
        flex: none;
        display: grid;
        place-items: center;
        inline-size: 2.75em;
        block-size: 2.75em;
        margin: 0;

        background-color: var(--color-surface-accent);
        border-radius: 50%;
        color: var(--color-accent-text);
        font-weight: var(--font-weight--semi-bold);
    }

    :host .instructor-name {
        margin-block: 0 0.15em;
        font-size: max(var(--base-font-size), 1.15em);
    }

    :host .instructor-meta {
        margin-block: 0 0.75em;
        color: var(--color-text-muted);
        font-size: max(var(--base-font-size), 0.92em);
    }

    :host .cta {
        color: var(--color-link);
    }

    /* The address is an operable target: 44px tall (WCAG 2.5.5). */
    :host a[data-email] {
        display: inline-flex;
        align-items: center;
        min-block-size: var(--target-min);
        /* The address breaks at its <wbr>s; this is the last resort for one unbreakable token. */
        overflow-wrap: anywhere;
        min-inline-size: 0;
    }

    /* On a phone the card and the fact list stack, and their children may shrink below their content. */
    :host .instructor-card > *,
    :host .who > * {
        min-inline-size: 0;
    }

    @media screen and (width < 30em) {
        :host .instructor-card,
        :host .who {
            flex-direction: column;
        }

        :host .facts {
            grid-template-columns: minmax(0, 1fr);
        }

        :host .facts dt {
            padding-block-start: 0.4em;
        }
    }

    /* print.css collapses the facts to one inline run by id selector; match
       its specificity to drop a screen-only row. */
    @media print {
        :host#instructor .facts > div.screen-only {
            display: none;
        }
    }
</style>

<style>
    /* Icon links (`contactLinks: "icons"`): the email, the message link and the
       blog as 44px circles beside the "Your instructor" heading, at the top
       right of the panel. They follow the facts in the source, so print, which
       drops the photo and runs the facts into one line, reads facts first and
       then the address and the host in place of the icons. Plain selectors,
       not the scoped block above: that block is what every other site renders. */
    /* The heading and the icons share the first line; when the column is too
       narrow for both, the icons wrap onto a line of their own, still at the
       right. The facts and the note take full lines. `order` puts the icons
       after the heading on screen while they follow the facts in the source. */
    #instructor .facts-column:has(> .links) {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        column-gap: var(--content-space);

        @media print {
            display: block;
        }
    }

    #instructor .facts-column:has(> .links) > h2 {
        flex: 1 1 auto;
        margin-block: 0;
    }

    #instructor .facts-column:has(> .links) > .facts {
        flex: 1 1 100%;
        order: 2;
        margin-block-start: 0.35em;
    }

    #instructor .facts-column:has(> .links) > .note {
        flex: 1 1 100%;
        order: 3;
    }

    #instructor .links {
        flex: none;
        order: 1;
        margin: 0 0 0 auto;
        padding: 0;
        display: flex;
        gap: 0.5em;
        list-style: none;

        @media print {
            display: inline;
        }
    }

    #instructor .links > li {
        margin: 0;
        padding: 0;

        @media print {
            display: inline;

            &::before {
                content: " · ";
            }

            /* The message link stands in for the address on screen only. */
            &.screen-only {
                display: none;
            }
        }
    }

    #instructor .icon-link {
        position: relative;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        box-sizing: border-box;
        /* An operable target: 44px each way (WCAG 2.5.5), the icon 24px inside it. */
        inline-size: var(--target-min);
        block-size: var(--target-min);
        aspect-ratio: auto;
        border: var(--thin-border-width) solid var(--color-border-strong);
        border-radius: var(--circle-border-radius);
        color: var(--color-link);
        text-decoration: none;

        &:is(:hover, :focus-visible) {
            border-color: var(--color-link);
            background-color: var(--color-surface-accent);
            text-decoration: none;
        }

        /* base.css gives an svg without a size a full-width, 2.5em-tall box and a currentColor fill. These carry a width, a height and fill="none"; say so
           again for any rule that is looser. */
        svg {
            flex: none;
            inline-size: 24px;
            block-size: 24px;
            min-block-size: 0;
            fill: none;
        }

        @media print {
            display: inline;
            inline-size: auto;
            block-size: auto;
            border: none;
            border-radius: 0;
            color: inherit;
            text-decoration: underline;

            svg {
                display: none;
            }
        }
    }

    /* The address, the message label or the host behind each icon: clipped on
       screen, where the aria-label names the link, and printed in place of
       the icon. It stays in the text, so find-in-page and copy reach it. */
    @media screen {
        #instructor .link-text {
            position: absolute;
            inline-size: 1px;
            block-size: 1px;
            overflow: hidden;
            clip-path: inset(50%);
            white-space: nowrap;
        }
    }

    @media (forced-colors: active) {
        #instructor .icon-link {
            border-color: LinkText;
        }

        #instructor .icon-link:is(:hover, :focus-visible) {
            border-color: Highlight;
        }
    }
</style>

<script>
	for (const link of document.querySelectorAll("a[data-email]")) {
		const email = atob(link.dataset.email);
		link.href = `mailto:${email}`;
		// An icon link keeps its svg and writes the address into its own text slot.
		const target = link.querySelector("[data-email-text]") ?? link;
		if (target.textContent.trim()) continue;
		// Break opportunities before "@" and after each ".": a narrow screen wraps the address there, not mid-word.
		email.split(/(?=@)|(?<=\.)/).forEach((part, index) => {
			if (index) target.append(document.createElement("wbr"));
			target.append(part);
		});
	}
</script>
