<script webc:setup>
	/**
	 * Every week of the term as a bordered block: its meetings (topics,
	 * readings, deadlines, deck and demos) beside the week's materials.
	 * @prop {object[]} [weeks] `scheduleWeeks` output; built from the page's
	 *   lessons, schedule, decks and demos when left out
	 */
	const defaultWeeks = scheduleWeeks($data.lessons, $data.schedule?.weeks, $data.collections?.deck, $data.demos);
</script>
<div webc:root="override" class="schedule-weeks" data-today-host="meetings" webc:if="(weeks ?? defaultWeeks)?.length">
    <today-marker></today-marker>
    <div class="week-tools" data-week-tools hidden>
        <div class="this-week" data-this-week hidden>
            <p class="eyebrow-label">This week</p>
            <a class="this-week-link" data-this-week-link href="#today"></a>
            <p class="this-week-dates" data-this-week-dates></p>
        </div>
        <div class="tool-row">
            <ul class="due-key" aria-label="Key" role="list" data-due-key hidden>
                <li><span class="due-kind" data-kind="test">Quiz or test</span> Graded</li>
                <li><span class="due-kind" data-kind="lab">Lab or project</span> Graded</li>
                <li><span class="due-kind" data-kind="practice">Practice</span> Not graded</li>
            </ul>
            <button type="button" class="past-toggle" aria-pressed="false" data-past-toggle>Hide past weeks</button>
        </div>
    </div>
    <week-block webc:for="week of (weeks ?? defaultWeeks)" :@number="week.week" :@dates="week.dates">
        <div class="week-body">
            <ol class="meetings" role="list">
                <meeting-card webc:for="meeting of week.meetings" :@meeting="meeting">
                    <span slot="when" class="note" webc:if="meeting.substitution">Runs a <span @text="meeting.substitution"></span> schedule</span>
                    <p class="no-class" webc:if="meeting.noClass">No class — <span @text="meeting.noClass"></span></p>
                    <ul class="topics" role="list" webc:if="!meeting.noClass">
                        <li webc:for="topic of meeting.topics" @raw="topic"></li>
                    </ul>
                    <assigned-list @label="Read before class" @prefix="due " :@items="meeting.noClass ? [] : meeting.readings"></assigned-list>
                    <assigned-list @label="Due" :@items="meeting.noClass ? [] : meeting.due"></assigned-list>
                    <meeting-decks :@meeting="meeting"></meeting-decks>
                    <div class="demos" webc:if="meeting.demos?.length">
                        <p class="label">Demos</p>
                        <ul role="list">
                            <li webc:for="demo of meeting.demos"><arrow-link :href="demo.url"><span @text="demo.title"></span></arrow-link></li>
                        </ul>
                    </div>
                </meeting-card>
            </ol>
            <div class="materials">
                <assigned-list @label="Read before class" @prefix="due " :@items="week.readings"></assigned-list>
                <hr webc:if="week.readings?.length">
                <div class="group">
                    <p class="label">Resources</p>
                    <p class="pending" webc:if="!week.resources?.length">Nothing posted yet.</p>
                    <ul role="list" webc:if="week.resources?.length">
                        <li webc:for="resource of week.resources">
                            <a :href="resource.href" @text="resource.title"></a>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </week-block>
</div>

<script>
	/**
	 * <schedule-weeks>: mark each week Now or Done (by campus date), point the
	 * "This week" panel at the current week, and let readers hide past weeks.
	 * Without the script every week shows and the tools stay hidden.
	 */
	(() => {
		try {
			const today = new Date().toLocaleDateString("en-CA", { timeZone: document.documentElement.dataset.timezone || undefined });
			for (const host of document.querySelectorAll(".schedule-weeks")) {
				const tools = host.querySelector("[data-week-tools]");
				const weeks = [...host.querySelectorAll(":scope > .week")].map((week) => ({
					week,
					dates: [...week.querySelectorAll("[data-date]")].flatMap((el) => el.dataset.date.split(/\s+/)).filter(Boolean).sort(),
				}));
				const dated = weeks.filter(({ dates }) => dates.length);
				if (!tools || !dated.length) continue;
				const current = dated.find(({ dates }) => dates.at(-1) >= today);
				for (const { week, dates } of dated) {
					const head = week.querySelector(".week-head");
					const state = week === current?.week ? "now" : dates.at(-1) < today ? "done" : "";
					if (!state || !head) continue;
					week.dataset.week = state;
					const flag = document.createElement("span");
					flag.className = "week-flag";
					flag.textContent = state === "now" ? "Now" : "Done";
					head.append(flag);
				}
				if (current) {
					const link = tools.querySelector("[data-this-week-link]");
					link.href = `#${current.week.id}`;
					link.textContent = current.week.querySelector(".week-title")?.textContent.trim() ?? "";
					tools.querySelector("[data-this-week-dates]").textContent = current.week.querySelector(".week-of")?.textContent.trim() ?? "";
					tools.querySelector("[data-this-week]").hidden = false;
				}
				tools.querySelector("[data-due-key]").hidden = !host.querySelector(".assigned .due-kind[data-kind]");
				const toggle = tools.querySelector("[data-past-toggle]");
				toggle.hidden = !dated.some(({ week }) => week.dataset.week === "done");
				toggle.addEventListener("click", () => {
					const hide = toggle.getAttribute("aria-pressed") !== "true";
					toggle.setAttribute("aria-pressed", String(hide));
					toggle.textContent = hide ? "Show past weeks" : "Hide past weeks";
					for (const { week } of dated) if (week.dataset.week === "done") week.hidden = hide;
				});
				tools.hidden = false;
			}
		} catch {
			// Never let the schedule tools break the scripts bundled after them.
		}
	})();
</script>

<style webc:scoped>
    /* "This week" and the past-weeks toggle, above the weeks. */
    .week-tools {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 0.75em 1.5em;
        padding: 0.9em 1.1em;
        border: var(--border-width) solid var(--color-accent-secondary);
        border-radius: var(--standard-border-radius);
        background-color: color-mix(in srgb, var(--color-accent-secondary) 10%, var(--color-page));

        &[hidden] {
            display: none;
        }
    }

    .this-week {
        display: grid;
        gap: 0.15em;

        p {
            margin: 0;
        }
    }

    .eyebrow-label {
        color: var(--color-text-muted);
        font-size: var(--font-size-6);
        font-weight: var(--font-weight--medium);
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }

    .this-week-link {
        font-size: var(--font-size-4);
        font-weight: var(--font-weight--semi-bold);
    }

    .this-week-dates {
        color: var(--color-text-muted);
    }

    .tool-row {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.75em 1.25em;
    }

    /* The chips' key, matching assigned-list's chips. */
    .due-key {
        display: flex;
        flex-wrap: wrap;
        gap: 0.4em 1em;
        margin: 0;
        padding: 0;
        list-style: none;
        color: var(--color-text-muted);
        font-size: max(var(--base-font-size), 0.9em);

        &[hidden] {
            display: none;
        }
    }

    .due-kind {
        display: inline-block;
        margin-inline-end: 0.3em;
        padding: 0 0.55em;
        border: var(--thin-border-width) solid transparent;
        border-radius: 9999px;
        color: var(--color-text);
        font-weight: var(--font-weight--semi-bold);

        &[data-kind="test"] { border: var(--border-width) solid var(--color-accent); }
        &[data-kind="lab"] { background-color: var(--color-surface-accent); }
        &[data-kind="practice"] { border-style: dashed; border-color: var(--color-text-muted); font-weight: var(--font-weight); }
    }

    .past-toggle {
        min-block-size: 44px;
        padding-inline: 1.1em;
        border: var(--border-width) solid var(--color-text-muted);
        border-radius: 9999px;
        background: transparent;
        color: var(--color-text);
        font: inherit;
        font-weight: var(--font-weight--semi-bold);
        cursor: pointer;
    }

    /* A week's flag: Now on the wayfinding color, Done muted. */
    :host :is(.week-flag) {
        margin-inline-start: auto;
        padding: 0 0.6em;
        border-radius: 9999px;
        font-size: max(var(--base-font-size), 0.85em);
        font-weight: var(--font-weight--semi-bold);
    }

    :host .week[data-week="now"] {
        border-color: var(--color-accent-secondary);
        box-shadow: inset var(--border-width) 0 0 var(--color-accent-secondary);

        .week-flag {
            background-color: var(--color-accent-secondary);
            color: var(--color-on-accent-secondary);
        }
    }

    :host .week[data-week="done"] .week-flag {
        color: var(--color-success);

        &::before {
            content: "\2713\00a0" / "";
        }
    }

    /* The meetings down the left and the week's reading and materials on the
       right. Stacks to a single column on narrow screens, so nothing scrolls
       sideways. */
    :host {
        display: grid;
        gap: var(--content-space);
    }

    .week-body {
        display: grid;
        grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);

        @media screen and (width <= 860px) {
            grid-template-columns: minmax(0, 1fr);
        }
    }

    .meetings {
        list-style: none;
        margin: 0;
        padding: 0;
    }

    .note,
    .no-class,
    .pending,
    .label {
        color: var(--color-text-muted);
        font-size: max(var(--base-font-size), 0.9em);
    }

    .note {
        font-style: italic;
    }

    .no-class {
        margin: 0;
    }

    .topics {
        list-style: none;
        margin: 0;
        padding: 0;

        li + li {
            margin-block-start: 0.25em;
        }
    }

    /* A meeting's demos sit under its deck links in a labelled region. */
    .demos {
        margin: 0.6em 0 0;
        font-size: max(var(--base-font-size), 0.92em);

        ul {
            list-style: none;
            margin: 0;
            padding: 0;
        }

        li + li {
            margin-block-start: 0.2em;
        }
    }

    .materials {
        display: flex;
        flex-direction: column;
        justify-content: space-around;
        padding: 0.8em 1em;
        border-inline-start: var(--thin-border-width) solid var(--color-border);

        @media screen and (width <= 860px) {
            border-inline-start: none;
            border-block-start: var(--thin-border-width) solid var(--color-border);
        }

        ul {
            list-style: none;
            margin: 0;
            padding: 0;
        }

        li + li {
            margin-block-start: 0.25em;
        }

        hr {
            inline-size: 100%;
            margin-block: 0.8em;
            border: 0;
            border-block-start: var(--thin-border-width) solid var(--color-border);
        }
    }

    .label {
        margin: 0 0 0.2em;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        font-size: var(--font-size-6);
    }

    .pending {
        margin: 0;
    }
</style>
