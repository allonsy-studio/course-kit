<script webc:setup>
	/**
	 * The policies section: one disclosure per entry in `policies.json`, open by
	 * default, each with an optional link to the full policy. Renders nothing
	 * without `policies`.
	 */
</script>
<section webc:root="override" class="content-column" aria-labelledby="policies-heading" webc:if="$data.policies">
	<h2 id="policies-heading" @text="$data.copy.policies.policies"></h2>
	<div class="disclosures">
		<details webc:for="entry of Object.entries($data.policies).filter(([key]) => key !== '$schema')" :id="`policy-${entry[0]}`" open>
			<summary @text="entry[1].title"></summary>
			<p @text="expandTokens(entry[1].body, $data)"></p>
			<p webc:if="entry[1].href"><a :href="entry[1].href" @text="entry[1].hrefText ?? $data.copy.policies.readTheFullPolicy"></a></p>
		</details>
	</div>
</section>
