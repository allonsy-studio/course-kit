<script webc:setup>
	/**
	 * The syllabus: outcomes, text, technology, coursework and grading. Reads
	 * the `course`, `grading`, `scale`, `schedule` and `project` data; it takes
	 * no props.
	 */
	const course = $data.course ?? {};
	const copy = $data.copy.syllabus;
	/** The project's due date and time: "Thursday, December 3, 2026, 11:59PM". */
	const projectWhen = (project) => (project.dueTime ? fill(copy.projectDue, { date: fullDate(project.due), time: timeOfDay(project.dueTime) }) : fullDate(project.due));
	const escape = (text) => String(text).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/"/g, "&quot;");
	/** "Full requirements, milestone dates, and the grading rubric are on the project page." with the link in place. */
	const projectPage = (project) => fill(copy.projectPage, { link: `<a href="${escape(project?.url ?? "/projects/final/")}">${escape(copy.projectPageLink)}</a>` });
</script>
<section id="syllabus" aria-labelledby="syllabus-heading" webc:root="override">
    <h2 id="syllabus-heading" @text="copy.syllabus"></h2>

    <article>
        <h3 @text="copy.learningOutcomes"></h3>
        <p @text="copy.uponCompletingThisCourse"></p>
        <ul>
            <li webc:for="outcome of course.outcomes" @text="outcome"></li>
        </ul>
    </article>

    <article webc:if="course.additionalOutcomes?.length">
        <h3 id="additional-outcomes" @text="copy.additionalOutcomesInThis"></h3>
        <ul>
            <li webc:for="outcome of course.additionalOutcomes" @text="outcome"></li>
        </ul>
    </article>

    <article>
        <h3 @text="copy.text"></h3>
        <p webc:if="!course.textbook?.required" @text="copy.noTextIsRequired"></p>
        <p webc:if="course.textbook?.required"><strong @text="copy.required"></strong> <span @text="course.textbook.required"></span></p>
        <ol webc:if="course.textbook?.access?.length">
            <li webc:for="step of course.textbook.access" @raw="step"></li>
        </ol>
    </article>

    <article>
        <h3 @text="copy.technology"></h3>
        <p><span @text="fill(copy.bringALaptopMeeting, { institution: $data.site.institution || copy.theCollege })"></span> <span webc:for="req of course.requirements ?? []" @text="req"></span> <span webc:if="$data.grading?.homework" @text="fill(copy.accessIsRequired, { lms: $data.site.lms })"></span></p>
    </article>

    <article webc:if="$data.grading">
        <h3 id="coursework" @text="copy.coursework"></h3>
        <div class="course-item" webc:for="entry of Object.entries($data.grading).filter(([key]) => key !== '$schema')">
            <h4><span @text="entry[1].title"></span> <span class="weight screen-only" webc:if="entry[1].weight" @text="entry[1].weight"></span></h4>
            <p @text="expandTokens(entry[1].body, $data)"></p>
            <template webc:nokeep webc:if="entry[0] === 'final' && $data.schedule?.finalExam">
                <p><strong @text="copy.exam"></strong> <span @text="examSlot($data.schedule.finalExam)"></span></p>
                <callout :type="'warn'" webc:if="$data.schedule.finalExam?.note">
                    <p @text="$data.schedule.finalExam.note"></p>
                </callout>
            </template>
            <template webc:nokeep webc:if="entry[0] === 'project'">
                <p>
                    <strong @text="copy.due"></strong>
                    <span webc:if="$data.project?.due" @text="`${projectWhen($data.project)}.`"></span><span webc:if="!$data.project?.due" @text="`${fill(copy.atTheLastClassMeeting, { lastMeeting: lastMeeting($data.lessons) })}.`"></span>
                </p>
                <p @raw="projectPage($data.project)"></p>
                <ul class="print-only" webc:if="$data.projectStages">
                    <li webc:for="stage of $data.projectStages.components">
                        <strong @text="stage.name"></strong> — <span @text="fill(copy.points, { display: stage.display, points: stage.points })"></span>
                    </li>
                </ul>
            </template>
        </div>
    </article>

    <article webc:if="$data.grading">
        <h3 id="grading" @text="copy.grading"></h3>
        <grading></grading>
    </article>

    <article webc:if="$data.term.keyDates?.length">
        <h3 id="key-dates" @text="copy.keyDates"></h3>
        <ul>
            <li webc:for="item of $data.term.keyDates"><strong @text="item.label"></strong><span class="print-only"> — </span><span @text="item.display"></span></li>
            <li webc:if="$data.schedule?.finalExam"><strong @text="copy.thisSectionsFinalExam"></strong><span class="print-only"> — </span><span @text="examSlot($data.schedule.finalExam)"></span></li>
        </ul>
    </article>
</section>

<style>
    #syllabus article {
        border: none;
        border-radius: 0;
        padding: 0;
        margin-block-end: 0;
    }

    /* Screen layout only: a single stacked column with a reading measure,
       coursework as a card grid with the weight on each card, and key dates
       as a stacked list. print.css keeps its own hooks (`#syllabus > article`,
       `#coursework ~ div`, `#grading`, `#key-dates`), none of which this
       markup changes. */
    @media screen {
        /* The section's row-gap is the only vertical rhythm between
           articles: each article's first heading and last block drop their
           own outer margins so nothing stacks on top of the gap. */
        #syllabus {
            display: grid;
            row-gap: var(--section-space);
        }

        #syllabus > h2 {
            margin-block-end: 0;
        }

        #syllabus > article > :first-child {
            margin-block-start: 0;
        }

        #syllabus > article > :last-child {
            margin-block-end: 0;
        }

        #syllabus > article > :where(p, ul, ol) {
            max-inline-size: 70ch;
        }

        /* Cards wrap as a centered flex row rather than a grid, so a short
           last row (two cards under three) is centered instead of hugging
           the left; each card is capped at a third of the row so the
           widths still match across rows. */
        #syllabus article:has(> #coursework) {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: var(--content-space);
        }

        #coursework {
            flex: 1 0 100%;
            margin-block-end: 0;
        }

        #coursework ~ .course-item {
            flex: 1 1 20em;
            max-inline-size: calc((100% - 2 * var(--content-space)) / 3);

            @media (width <= 60em) {
                max-inline-size: none;
            }
        }

        #coursework ~ .course-item {
            box-sizing: border-box;
            display: flex;
            flex-direction: column;
            padding: calc(var(--content-space) * 1.1);
            border: var(--thin-border-width) solid var(--color-border);
            border-radius: var(--standard-border-radius);

            h4 {
                display: flex;
                flex-wrap: wrap;
                align-items: baseline;
                justify-content: space-between;
                gap: 0.25em 0.75em;
                margin-block: 0 0.5em;
            }

            /* Flex items do not collapse margins, so paragraphs keep only
               their bottom margin. */
            > p {
                margin-block-start: 0;
            }

            p:last-child {
                margin-block-end: 0;
            }

            /* A callout sits at the foot of its card, so the cards in a
               row line up. */
            .callout {
                margin-block: auto 0;
            }
        }

        #coursework ~ .course-item .weight {
            flex: none;
            padding: 0.1em 0.6em;
            border-radius: var(--pill-border-radius);
            background-color: color-mix(in oklab, var(--color-accent) 24%, transparent);
            color: var(--color-accent-text);
            font-size: var(--font-size-6);
            font-weight: var(--font-weight--semi-bold);
            letter-spacing: 0.03em;
        }

        #key-dates + ul {
            list-style: none;
            margin: 0;
            padding: 0;

            li {
                display: flex;
                flex-wrap: wrap;
                gap: 0 0.75em;
                padding-block: 0.4em;
                border-block-start: var(--thin-border-width) solid var(--color-border);
            }

            li > strong {
                flex: 0 1 22em;
            }

            li > span:last-child {
                color: var(--color-text-muted);
            }
        }
    }
</style>
