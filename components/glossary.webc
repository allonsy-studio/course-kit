<article class="content-column glossary" id="glossary" webc:if="$data.glossary?.terms?.length">
	<header>
		<eyebrow class="separators">
			<span @text="$data.term.label"></span>
			<span @text="$data.course.code"></span>
			<span>Glossary</span>
		</eyebrow>
		<h1>Course glossary</h1>
		<p class="intro">
			<strong @text="$data.glossary.terms.length"></strong> terms from class. Each carries tags for its test,
			its <span @text="$data.glossary.readingLabel.toLowerCase()"></span> and the meeting that taught it.
			Group by any of them, search, or narrow the list to what you are studying.
		</p>
	</header>

	<div data-static>
		<section class="group" webc:for="group of $data.glossary.az" :id="`g-az-${group.key}`" :aria-labelledby="`g-az-${group.key}-h`">
			<h2 class="heading" :id="`g-az-${group.key}-h`">
				<span class="name" @text="group.label"></span>
				<span class="aside">
					<span class="count"><span @text="group.terms.length"></span> <span @text="group.terms.length === 1 ? 'term' : 'terms'"></span></span>
				</span>
			</h2>
			<dl>
				<div class="entry" webc:for="item of group.terms">
					<dt>
						<span class="term" @raw="item.term"></span>
						<span class="api-group" webc:if="item.group" @text="item.group"></span>
					</dt>
					<dd>
						<p class="sig" webc:if="item.sig" @raw="item.sig"></p>
						<p class="definition" @raw="item.definition"></p>
						<p class="meta" webc:if="item.meta" @raw="item.meta"></p>
						<p class="example" webc:if="item.example"><span class="label">Example</span> <span @raw="item.example"></span></p>
						<ul class="tags" role="list">
							<li webc:for="tag of item.tags.test" data-kind="test" @text="tag.label"></li>
							<li webc:for="tag of item.tags.chapter" data-kind="chapter" @text="tag.label"></li>
							<li webc:for="tag of item.tags.meeting" data-kind="meeting" @text="tag.label"></li>
							<li webc:for="tag of item.tags.topic" data-kind="topic" @text="tag.label"></li>
						</ul>
						<p class="links">
							<a webc:for="place of item.taught" :href="place.href"><span @text="`Week ${place.week} · ${place.weekday}, slide ${place.slide}`"></span></a>
							<a webc:if="item.ref" :href="item.ref.href" @text="item.ref.label"></a>
						</p>
					</dd>
				</div>
			</dl>
		</section>
	</div>

	<div data-app hidden></div>

	<script type="application/json" id="glossary-data" webc:keep @raw="$data.glossary.json"></script>
	<script type="module" src="/js/glossary.js" webc:keep></script>
</article>

<style webc:scoped>
	:host {
		display: block;
		--chip-size: 2.5rem;
		--count-gap: 0.65rem;

		/* ---- Tag palette: one hue family per kind of tag ----
		   Test is amber, reading (chapter) is blue, class meeting is green; none is
		   the teal or magenta a course accents with. -bg/-fg/-border colour a label
		   or an unpressed chip; -on-bg/-on-fg a pressed chip; -mark the accent on a
		   group heading. Every text pair is at least 4.5:1, every border and mark at
		   least 3:1 against the page, in both modes (light-dark() follows the
		   color-scheme the theme switcher sets). */
		--glossary-test-bg: light-dark(#f9eddc, #493a27);
		--glossary-test-fg: light-dark(#553307, #fadfbd);
		--glossary-test-border: light-dark(#9b723b, #ab8149);
		--glossary-test-on-bg: light-dark(#77490d, #f8d6aa);
		--glossary-test-on-fg: light-dark(#ffffff, #2b1c08);
		--glossary-test-mark: light-dark(#b37019, #e7a855);

		--glossary-reading-bg: light-dark(#dce2f9, #272e49);
		--glossary-reading-fg: light-dark(#071655, #bdc9fa);
		--glossary-reading-border: light-dark(#4156aa, #7081c2);
		--glossary-reading-on-bg: light-dark(#0d2277, #aabaf8);
		--glossary-reading-on-fg: light-dark(#ffffff, #080f2b);
		--glossary-reading-mark: light-dark(#1938b3, #5572e7);

		--glossary-meeting-bg: light-dark(#dcf9e7, #274934);
		--glossary-meeting-fg: light-dark(#075523, #bdfad3);
		--glossary-meeting-border: light-dark(#328551, #49ab6d);
		--glossary-meeting-on-bg: light-dark(#0d7734, #aaf8c7);
		--glossary-meeting-on-fg: light-dark(#ffffff, #082b15);
		--glossary-meeting-mark: light-dark(#13863d, #55e78b);

		[data-kind="test"] {
			--k-bg: var(--glossary-test-bg);
			--k-fg: var(--glossary-test-fg);
			--k-border: var(--glossary-test-border);
			--k-on-bg: var(--glossary-test-on-bg);
			--k-on-fg: var(--glossary-test-on-fg);
			--k-mark: var(--glossary-test-mark);
		}

		[data-kind="chapter"] {
			--k-bg: var(--glossary-reading-bg);
			--k-fg: var(--glossary-reading-fg);
			--k-border: var(--glossary-reading-border);
			--k-on-bg: var(--glossary-reading-on-bg);
			--k-on-fg: var(--glossary-reading-on-fg);
			--k-mark: var(--glossary-reading-mark);
		}

		[data-kind="meeting"] {
			--k-bg: var(--glossary-meeting-bg);
			--k-fg: var(--glossary-meeting-fg);
			--k-border: var(--glossary-meeting-border);
			--k-on-bg: var(--glossary-meeting-on-bg);
			--k-on-fg: var(--glossary-meeting-on-fg);
			--k-mark: var(--glossary-meeting-mark);
		}

		.intro {
			color: var(--color-text-muted);
			margin-block: 0;
		}

		/* ---- Controls ---- */
		.bar {
			display: flex;
			flex-wrap: wrap;
			align-items: center;
			justify-content: space-between;
			gap: calc(var(--gutter) * 3) calc(var(--content-space) * 1.5);
			margin-block: calc(var(--content-space) * 1.5) var(--content-space);
			padding-block: var(--content-space);
			border-block: var(--thin-border-width) solid var(--color-border);
		}

		.bar-group {
			display: flex;
			flex-wrap: wrap;
			align-items: center;
			gap: calc(var(--gutter) * 2) var(--content-space);
		}

		.label {
			font-size: var(--font-size-6);
			font-weight: var(--font-weight--semi-bold);
			letter-spacing: 0.08em;
			text-transform: uppercase;
			color: var(--color-text-muted);
		}

		button {
			margin: 0;
			min-block-size: var(--chip-size);
			color: var(--color-text);
			background-color: var(--color-surface);
			border: var(--thin-border-width) solid var(--color-border);
			font-weight: var(--font-weight--medium);
			cursor: pointer;
			line-height: var(--font-height--dense);

			&:focus-visible {
				outline: var(--outline-width) solid var(--color-accent-text);
				outline-offset: var(--outline-offset);
			}

			&:disabled {
				opacity: 0.45;
				cursor: default;
			}
		}

		.seg {
			display: inline-flex;
			flex-wrap: wrap;
			border-radius: var(--standard-border-radius);

			button {
				padding-inline: 0.9em;
				border-radius: 0;
				margin-inline-start: calc(var(--thin-border-width) * -1);

				&:first-child {
					border-start-start-radius: var(--standard-border-radius);
					border-end-start-radius: var(--standard-border-radius);
					margin-inline-start: 0;
				}

				&:last-child {
					border-start-end-radius: var(--standard-border-radius);
					border-end-end-radius: var(--standard-border-radius);
				}

				&[aria-checked="true"] {
					background-color: var(--color-surface-accent);
					border-color: var(--color-accent-text);
					box-shadow: inset 0 calc(var(--border-width) * -1) 0 var(--color-accent-text);
					font-weight: var(--font-weight--bold);
					position: relative;
				}

				&[aria-selected="true"] {
					background-color: var(--color-text);
					border-color: var(--color-text);
					color: var(--color-page);
					min-inline-size: 6.5em;
					position: relative;
				}
			}
		}

		.modes button {
			min-inline-size: 6.5em;
		}

		.filters[open] summary::before {
			content: "\25BE";
			content: "\25BE" / "";
		}

		.filters {
			margin: 0;
			padding: 0;
			padding-block-end: calc(var(--gutter) * 2);
			border: 0;
			border-block-end: var(--thin-border-width) solid var(--color-border);
			border-radius: 0;
			background: none;

			summary {
				cursor: pointer;
				font-weight: var(--font-weight--medium);
				min-block-size: var(--chip-size);
				display: flex;
				align-items: center;
				gap: 0.5em;

				&::before {
					content: "\25B8";
					content: "\25B8" / "";
					color: var(--color-accent-text);
				}

				&:focus-visible {
					outline: var(--outline-width) solid var(--color-accent-text);
					outline-offset: var(--outline-offset);
				}
			}
		}

		.filter-rows {
			display: grid;
			gap: var(--content-space);
			padding: calc(var(--gutter) * 2) 0 var(--content-space);
		}

		.filter-row {
			display: flex;
			flex-wrap: wrap;
			align-items: center;
			gap: calc(var(--gutter) * 2);

			&[hidden] {
				display: none;
			}

			> .label {
				inline-size: 6em;
			}

			.chips {
				display: flex;
				flex-wrap: wrap;
				gap: calc(var(--gutter) * 2);
			}
		}

		.chip {
			display: inline-flex;
			align-items: center;
			gap: var(--count-gap);
			padding: 0.3em 0.8em;
			border-radius: var(--pill-border-radius);

			.t {
				display: inline-flex;
				align-items: center;
				gap: 0.4em;
			}

			.n {
				color: var(--color-text-muted);
				font-size: 0.85em;
				font-weight: var(--font-weight);
				font-variant-numeric: tabular-nums;
			}

			&[data-kind] {
				background-color: var(--k-bg);
				border-color: var(--k-border);
				color: var(--k-fg);

				.n {
					color: color-mix(in srgb, var(--k-fg) 78%, var(--k-bg));
				}
			}

			&[aria-pressed="true"] {
				background-color: var(--color-surface-accent);
				border-color: var(--color-accent-text);
				border-width: var(--border-width);
				font-weight: var(--font-weight--bold);

				.t::before {
					content: "\2713";
					content: "\2713" / "";
				}

				.n {
					color: inherit;
				}

				&[data-kind] {
					background-color: var(--k-on-bg);
					border-color: var(--k-on-bg);
					color: var(--k-on-fg);

					.n {
						color: color-mix(in srgb, var(--k-on-fg) 85%, var(--k-on-bg));
					}
				}
			}

			/* The class meeting a link pre-filtered the list to: removable, no row of its own. */
			&.pill {
				font-weight: var(--font-weight--medium);

				&[data-kind] {
					background-color: var(--k-on-bg);
					border-color: var(--k-on-bg);
					color: var(--k-on-fg);
				}

				&::after {
					content: "\00D7";
					content: "\00D7" / "";
					font-size: 1.2em;
					line-height: 1;
				}
			}
		}

		.search {
			display: flex;
			flex-wrap: wrap;
			align-items: center;
			gap: calc(var(--gutter) * 2) var(--content-space);
			padding-block: var(--content-space) 0;

			.field {
				position: relative;
				display: flex;
				flex: 1 1 18rem;
				max-inline-size: 28rem;
			}

			input {
				inline-size: 100%;
				min-block-size: var(--chip-size);
				margin: 0;
				padding-inline: 0.8em 4.5em;
				color: var(--color-text);
				background-color: var(--color-page);
				border: var(--thin-border-width) solid var(--color-text-muted);
				border-radius: var(--standard-border-radius);
				font: inherit;

				&:focus-visible {
					outline: var(--outline-width) solid var(--color-accent-text);
					outline-offset: var(--outline-offset);
				}

				&::-webkit-search-cancel-button {
					display: none;
				}
			}

			.clear-search {
				position: absolute;
				inset-block: 0;
				inset-inline-end: 0;
				padding-inline: 0.8em;
				border: 0;
				background: none;
				color: var(--color-accent-text);
				text-decoration: underline;
			}
		}

		.status {
			margin-block: calc(var(--content-space) * 0.75) 0;
			color: var(--color-text-muted);

			button {
				min-block-size: var(--chip-size);
				padding-inline: 0.5em;
				border: 0;
				background: none;
				color: var(--color-accent-text);
				text-decoration: underline;
			}
		}

		/* ---- Review ---- */
		.group {
			padding-block-start: calc(var(--content-space) * 1.8);

			.heading {
				display: flex;
				flex-wrap: wrap;
				align-items: baseline;
				justify-content: space-between;
				gap: calc(var(--gutter) * 2) calc(var(--content-space) * 0.8);
				margin-block: 0;
				font-size: var(--font-size-4);
				font-weight: var(--font-weight--semi-bold);

				.aside {
					display: flex;
					flex-wrap: wrap;
					align-items: baseline;
					justify-content: flex-end;
					gap: calc(var(--gutter) * 2) calc(var(--content-space) * 0.8);
				}

				.when,
				.count,
				.deck {
					color: var(--color-text-muted);
					font-size: var(--font-size-5);
					font-weight: var(--font-weight);
					font-variant-numeric: tabular-nums;
				}
			}

			/* The accent mark names the kind a heading groups by. */
			&[data-kind] .heading {
				padding-inline-start: 0.6em;
				border-inline-start: var(--thick-border-width) solid var(--k-mark);
			}

			dl {
				margin-block: calc(var(--content-space) * 0.6) 0;
			}
		}

		.entry {
			display: grid;
			grid-template-columns: minmax(9rem, 14rem) 1fr;
			gap: calc(var(--gutter) * 1.5) var(--content-space);
			padding-block: calc(var(--content-space) * 0.8);
			border-block-start: var(--thin-border-width) solid var(--color-border);
			break-inside: avoid;

			@media (width < 560px) {
				grid-template-columns: 1fr;
			}

			dt {
				display: flex;
				flex-wrap: wrap;
				align-content: start;
				align-items: baseline;
				gap: calc(var(--gutter) * 1.5) calc(var(--gutter) * 2);
				color: var(--color-text);
				font-weight: var(--font-weight--bold);
				overflow-wrap: anywhere;
			}

			dd {
				margin: 0;
				min-inline-size: 0;

				p {
					margin-block: 0;
				}

				p + p,
				ul + p,
				p + ul {
					margin-block-start: calc(var(--gutter) * 1.5);
				}
			}

			.api-group,
			.known {
				font-size: var(--font-size-6);
				font-weight: var(--font-weight);
				color: var(--color-text-muted);
			}

			.known {
				color: var(--color-success);
			}

			.sig {
				font-family: var(--mono-font);
				font-size: var(--mono-font-size);
			}

			.meta,
			.example {
				color: var(--color-text-muted);
			}

			.label {
				margin-inline-end: 0.3em;
				font-size: var(--font-size-6);
				letter-spacing: 0.08em;
				text-transform: uppercase;
			}

			.tags {
				display: flex;
				flex-wrap: wrap;
				gap: calc(var(--gutter) * 1.5);
				margin: 0;
				padding: 0;
				list-style: none;

				li {
					padding: 0.1em 0.55em;
					border-radius: var(--standard-border-radius);
					background-color: var(--color-surface);
					font-size: var(--font-size-6);
					line-height: var(--font-height);

					&[data-kind] {
						border: var(--thin-border-width) solid var(--k-border);
						background-color: var(--k-bg);
						color: var(--k-fg);
					}
				}
			}

			.links {
				display: flex;
				flex-wrap: wrap;
				gap: 0 calc(var(--content-space) * 1.1);
				font-size: var(--font-size-6);

				a {
					padding-block: 0.25em;
				}
			}
		}

		.empty {
			display: grid;
			justify-items: center;
			gap: calc(var(--gutter) * 2);
			padding: calc(var(--content-space) * 2.5) var(--content-space);
			text-align: center;
			color: var(--color-text-muted);

			strong {
				color: var(--color-text);
				font-size: var(--font-size-4);
			}
		}

		/* ---- Flashcards ---- */
		.study {
			display: grid;
			gap: var(--content-space);
			padding-block-start: var(--content-space);
		}

		.study[hidden] {
			display: none;
		}

		.study-top {
			display: flex;
			flex-wrap: wrap;
			align-items: center;
			gap: calc(var(--gutter) * 2) var(--content-space);
			color: var(--color-text-muted);
			font-variant-numeric: tabular-nums;

			.opts {
				display: flex;
				flex-wrap: wrap;
				gap: calc(var(--gutter) * 2);
				margin-inline-start: auto;
			}
		}

		.meter {
			block-size: 4px;
			border-radius: 2px;
			background-color: var(--color-surface);
			overflow: hidden;

			i {
				display: block;
				block-size: 100%;
				background-color: var(--color-accent);

				@media (prefers-reduced-motion: no-preference) {
					transition: inline-size 0.25s;
				}
			}
		}

		.card {
			display: grid;
			grid-template-rows: auto 1fr auto;
			gap: calc(var(--content-space) * 0.7);
			min-block-size: 15rem;
			padding: calc(var(--content-space) * 1.5);
			border: var(--thin-border-width) solid var(--color-border);
			border-radius: calc(var(--standard-border-radius) * 3);
			background-color: var(--color-surface);

			&:focus-visible {
				outline: var(--outline-width) solid var(--color-accent-text);
				outline-offset: var(--outline-offset);
			}

			.top {
				display: flex;
				justify-content: space-between;
				gap: var(--content-space);
				font-size: var(--font-size-6);
				color: var(--color-text-muted);

				span {
					padding: 0.1em 0.55em;
					border-radius: var(--standard-border-radius);
					line-height: var(--font-height);
				}

				span[data-kind] {
					border: var(--thin-border-width) solid var(--k-border);
					background-color: var(--k-bg);
					color: var(--k-fg);
				}
			}

			.content {
				align-self: center;
				display: grid;
				gap: var(--content-space);
			}

			.front {
				text-align: center;
				font-size: clamp(1.6rem, 5vw, 2.3rem);
				font-weight: var(--font-weight--bold);
				overflow-wrap: anywhere;

				small {
					display: block;
					margin-block-start: calc(var(--gutter) * 1.5);
					font-size: var(--font-size-5);
					font-weight: var(--font-weight);
					color: var(--color-text-muted);
				}

				.sig {
					display: block;
					margin-block-start: var(--content-space);
					font-family: var(--mono-font);
					font-size: var(--font-size-5);
					font-weight: var(--font-weight);
				}
			}

			.back {
				display: grid;
				gap: calc(var(--gutter) * 2);

				p {
					margin-block: 0;
				}

				.definition {
					font-size: var(--font-size-4);
				}

				.sig {
					font-family: var(--mono-font);
				}

				.meta,
				.example {
					color: var(--color-text-muted);
				}

				.label {
					margin-inline-end: 0.3em;
					font-size: var(--font-size-6);
					letter-spacing: 0.08em;
					text-transform: uppercase;
				}

				.links {
					display: flex;
					flex-wrap: wrap;
					gap: 0 var(--content-space);
					font-size: var(--font-size-6);

					a {
						padding-block: 0.25em;
					}
				}
			}

			.foot {
				display: flex;
				justify-content: center;
			}
		}

		.primary {
			padding-inline: 1.4em;
			background-color: var(--color-text);
			border-color: var(--color-text);
			color: var(--color-page);
			font-weight: var(--font-weight--semi-bold);
		}

		.verdict {
			display: flex;
			flex-wrap: wrap;
			justify-content: center;
			gap: calc(var(--gutter) * 3);

			button {
