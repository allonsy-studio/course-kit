<script webc:setup>
	/**
	 * One worksheet question: its prompt, sources, snippet and figure, then the control its kind needs, then the feedback and the reasoning. `practice.js` grades it.
	 * @prop {object} q a prepared question; `q.kind` picks the control
	 */
</script>
<div class="question" :id="`q-${q.id}`" :data-question="q.id" :data-kind="q.kind"
	:data-answers="JSON.stringify(q.answers)">
	<div class="question-head">
		<p class="question-prompt"><span class="q-number" @text="q.id"></span> <span @text="q.prompt"></span></p>
		<cite-panel :@sources="q.sources" @group="cite" :@heading="$data.worksheet.copy.citeHeading"
			:@label="`${$data.worksheet.copy.citeLabel} ${q.id}`"></cite-panel>
	</div>

	<pre webc:if="q.code && q.kind !== 'tree'" class="snippet"><code @raw="q.codeHtml"></code></pre>
	<practice-figure webc:if="q.figure" :@q="q"></practice-figure>

	<choice-list webc:if="q.kind === 'choice'" :@choices="q.choices"
		:@legend="$data.worksheet.copy.chooseOne" @legendclass="sr-only"></choice-list>
	<practice-match webc:if="q.kind === 'match'" :@q="q"></practice-match>
	<practice-fill webc:if="q.kind === 'fill'" :@q="q"></practice-fill>
	<practice-tree webc:if="q.kind === 'tree'" :@q="q"></practice-tree>
	<practice-grid webc:if="q.kind === 'grid'" :@q="q"></practice-grid>
	<practice-judge webc:if="q.kind === 'judge'" :@q="q"></practice-judge>
	<practice-selfcheck webc:if="q.kind === 'selfcheck'" :@q="q"></practice-selfcheck>

	<button type="button" class="check-one" data-check-one hidden webc:if="$data.worksheet.checkMode === 'question' && q.kind !== 'selfcheck'" @text="$data.worksheet.copy.checkOne"></button>
	<p class="feedback" role="status" hidden></p>
	<div class="why" hidden>
		<p @text="q.why"></p>
	</div>
</div>

<style webc:scoped>
	:host {
		.question {
			background: var(--color-surface-subtle);
			border-inline-start: var(--thick-border-width) solid var(--color-border);
			border-radius: var(--standard-border-radius);
			margin-block: var(--practice-gap);
			padding: 0.9em 1em;

			&[data-state="right"] {
				border-inline-start-color: var(--color-success);

				.feedback {
					color: var(--color-success);

					&::before {
						content: "✓ ";
					}
				}
			}

			&:is([data-state="wrong"], [data-state="partial"]) {
				border-inline-start-color: var(--color-error);

				.feedback {
					color: var(--color-error);

					&::before {
						content: "✕ ";
					}
				}
			}

			&[data-state="partial"] {
				border-inline-start-style: dashed;
			}
		}

		.question-head {
			align-items: start;
			display: flex;
			gap: 0.5em;
			justify-content: space-between;
		}

		.question-prompt {
			margin-block: 0 0.6em;
		}

		.q-number {
			color: var(--color-accent-text);
			font-variant-numeric: tabular-nums;
			font-weight: var(--font-weight--bold);
			margin-inline-end: 0.3em;
		}

		.snippet {
			font-size: 0.9em;

			.token:is(.comment, .prolog, .doctype, .cdata) {
				color: var(--color-code-comment);
				font-style: italic;
			}

			.token:is(.keyword, .builtin, .important, .atrule) {
				color: var(--color-code-keyword);
				font-weight: var(--font-weight--semi-bold);
			}

			.token:is(.string, .char, .regex, .number, .boolean) {
				color: var(--color-code-string);
			}

			.token:is(.punctuation, .operator) {
				color: var(--color-text-muted);
			}
		}

		.check-one {
			min-block-size: var(--target-min);
			margin-block-start: 0.8em;
			padding-inline: 1.2em;
			border: var(--thin-border-width) solid var(--color-border-strong);
			border-radius: var(--radius-pill);
			background: transparent;
			color: var(--color-text);
			font-weight: var(--font-weight--semi-bold);
			cursor: pointer;
		}

		.feedback {
			font-weight: var(--font-weight--semi-bold);
			margin-block: 0.8em 0;
		}

		.why {
			background: var(--color-surface);
			border-radius: var(--standard-border-radius);
			margin-block-start: 0.5em;
			padding: 0.6em 0.9em;

			p {
				margin-block: 0;
			}
		}
	}
</style>
