<script webc:setup>
	/**
	 * A judge question: a verdict, then the one line of code that causes the problem.
	 * @prop {object} q a prepared `judge` question
	 */
</script>
<div class="judging">
	<div class="verdicts">
		<choice-list :@choices="q.verdicts" :@legend="$data.worksheet.copy.verdict"></choice-list>
	</div>
	<fieldset class="code-lines">
		<legend @text="$data.worksheet.copy.judgeLine"></legend>
		<pre class="lines"><code><label class="code-line" webc:for="codeLine of q.codeLines"><input type="radio" :name="codeLine.name" :value="codeLine.value"><span class="line-code" @raw="codeLine.html"></span></label></code></pre>
		<label class="code-line no-line">
			<input type="radio" :name="q.lineName" value="none">
			<span @text="$data.worksheet.copy.judgeNoLine"></span>
		</label>
	</fieldset>
</div>

<style webc:scoped>
	:host {
		legend {
			color: var(--color-text-muted);
			font-size: 0.85em;
			letter-spacing: 0.06em;
			padding-inline: 0;
			text-transform: uppercase;
		}

		.code-lines {
			border: 0;
			margin: 0;
			margin-block-start: var(--content-space);
			/* A fieldset defaults to min-content, which defeats the code's scroll. */
			min-inline-size: 0;
			padding: 0;
		}

		/* One label per line inside a <pre>, with nothing between the labels:
		   the HTML minifier leaves <pre> alone, which is what keeps the
		   snippet's indentation. */
		.lines {
			--token-string: color-mix(in oklab, var(--color-success) 60%, var(--color-text));
			background: var(--color-surface);
			border-radius: var(--standard-border-radius);
			font-size: 0.9em;
			margin: 0;
			overflow-x: auto;
			padding: 0.35em 0;

			/* A grid drops the whitespace-only text WebC leaves between the
			   looped labels, which a <pre> would otherwise show as blank lines. */
			code {
				background: none;
				display: grid;
				inline-size: max-content;
				min-inline-size: 100%;
				padding: 0;
			}

			.token:is(.comment, .prolog, .doctype, .cdata) {
				color: var(--color-text-muted);
				font-style: italic;
			}

			.token:is(.keyword, .builtin, .important, .atrule) {
				color: var(--color-accent-text);
				font-weight: var(--font-weight--semi-bold);
			}

			.token:is(.string, .char, .regex, .number, .boolean) {
				color: var(--token-string);
			}

			.token:is(.punctuation, .operator) {
				color: var(--color-text-muted);
			}
		}

		.code-line {
			align-items: center;
			border-inline-start: var(--thick-border-width) solid transparent;
			cursor: pointer;
			display: flex;
			gap: 0.6em;
			padding: 0.1em 0.6em;

			input {
				flex: none;
			}

			/* A blank line still gets a row the height of its neighbors. */
			.line-code {
				min-block-size: 1lh;
				white-space: pre;
			}

			&:hover {
				background: var(--color-accent-hover);
			}

			/* The chosen line lights up in the code itself. */
			&:has(input:checked) {
				background: color-mix(in srgb, var(--color-accent-text) 16%, transparent);
				border-inline-start-color: var(--color-accent-text);
			}

			&:has(input:focus-visible) {
				outline: 2px solid var(--color-accent-text);
				outline-offset: -2px;
			}

			&.no-line {
				font-size: 0.9em;
				margin-block-start: 0.3em;
			}

			&[data-mark="right"],
			&[data-mark="right"]:has(input:checked) {
				background: color-mix(in srgb, var(--color-success) 22%, var(--color-page));
				border-inline-start-color: var(--color-success);
			}

			&[data-mark="wrong"],
			&[data-mark="wrong"]:has(input:checked) {
				background: color-mix(in srgb, var(--color-error) 22%, var(--color-page));
				border-inline-start-color: var(--color-error);
			}
		}
	}
</style>
