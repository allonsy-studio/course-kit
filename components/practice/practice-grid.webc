<script webc:setup>
	/**
	 * A grid question: rows of choices across columns.
	 * @prop {object} q a prepared `grid` question
	 */
</script>
<table class="grid">
	<thead>
		<tr>
			<th scope="col" @text="q.rowHeader"></th>
			<th scope="col" webc:for="column of q.columns" @text="column"></th>
		</tr>
	</thead>
	<tbody>
		<tr webc:for="row of q.rows" :data-row="row.index">
			<th scope="row">
				<span @text="row.text"></span>
				<span class="answer-key" hidden :data-answer="row.display"
					@text="`${$data.worksheet.copy.answer} ${row.display}`"></span>
			</th>
			<td webc:for="cell of row.cells">
				<label>
					<span class="sr-only" @text="cell.column"></span>
					<input type="radio" :name="cell.name" :value="cell.value">
				</label>
			</td>
		</tr>
	</tbody>
</table>

<style webc:scoped>
	/* A grid wider than the column scrolls inside its own box, not the page. */
	:host {
		display: block;
		max-inline-size: 100%;
		overflow-x: auto;

		.answer-key {
			color: var(--color-error);
			font-size: 0.85em;

			&:not([hidden]) {
				display: block;
			}
		}

		th[scope="row"] {
			font-weight: var(--font-weight);
			text-align: start;

			tr[data-mark="wrong"] & {
				color: var(--color-error);
			}
		}
	}
</style>

<script>
(() => {
	const registry = (window.ckPractice ??= { kinds: {} });
	registry.kinds.grid = {
		/** Mark this kind's controls and report what was found. */
		grade(question, key, id, { mark, checkedValue }) {
			let right = 0;
			let blank = 0;
			let answered = false;
			for (const [index, expected] of key.rows.entries()) {
				const picked = checkedValue(question, `${id}-row-${index}`);
				if (picked === null) {
					blank += 1;
					continue;
				}
				answered = true;
				const correct = Number(picked) === expected;
				if (correct) right += 1;
				mark(question.querySelector(`tr[data-row="${index}"]`), correct);
			}
			return { answered, right, total: key.rows.length, blank };
		},
	};
})();
</script>
