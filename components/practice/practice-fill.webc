<script webc:setup>
	/**
	 * A fill-in question: a word bank and a numbered list of blanks.
	 * @prop {object} q a prepared `fill` question
	 */
</script>
<div class="filling">
	<p class="drag-hint" webc:if="q.dragHint" @text="q.dragHint"></p>
	<p class="word-bank" webc:if="q.bank">
		<span class="word-bank-label" @text="$data.worksheet.copy.wordBank"></span>
		<span class="word" webc:for="word of q.bank"
			:draggable="word.draggable" :data-word="word.text" @text="word.text"></span>
	</p>
	<ol class="blanks">
		<li webc:for="blank of q.blanks" :data-drop="blank.drop">
			<label>
				<span class="blank-label" @text="blank.label"></span>
				<input type="text" autocomplete="off" spellcheck="false"
					:name="blank.name" :data-blank="blank.index" :placeholder="blank.hint">
			</label>
			<span class="answer-key" hidden :data-answer="blank.display"
				@text="`${$data.worksheet.copy.answer} ${blank.display}`"></span>
		</li>
	</ol>
</div>

<style webc:scoped>
	:host {
		.drag-hint {
			color: var(--color-text-muted);
			font-size: 0.9em;
			margin-block: 0 0.6em;
		}

		.answer-key {
			color: var(--color-error);
			font-size: 0.85em;

			&:not([hidden]) {
				display: block;
			}
		}

		.word-bank {
			align-items: baseline;
			display: flex;
			flex-wrap: wrap;
			gap: 0.4em;

			.word-bank-label {
				color: var(--color-text-muted);
				font-size: 0.85em;
				letter-spacing: 0.06em;
				text-transform: uppercase;
			}

			.word {
				background: var(--color-surface);
				border-radius: var(--standard-border-radius);
				font-family: var(--mono-font);
				padding: 0.1em 0.5em;

				&[draggable="true"] {
					border: var(--thin-border-width) dashed var(--color-border);
					cursor: grab;

					&:active {
						cursor: grabbing;
					}
				}

				&[data-dragging] {
					opacity: 0.45;
				}

				&[data-used] {
					opacity: 0.5;
					text-decoration: line-through;
				}
			}
		}

		.blanks {
			list-style: none;
			padding-inline-start: 0;

			label {
				align-items: center;
				display: flex;
				flex-wrap: wrap;
				gap: 0.6em;
				margin-block: 0.4em;
			}

			.blank-label {
				flex: 0 1 24em;
			}

			input {
				flex: 0 1 14em;
				font-family: var(--mono-font);
			}

			li {
				&[data-drop] {
					border: var(--thin-border-width) dashed transparent;
					border-radius: var(--standard-border-radius);

					&[data-over] {
						background: var(--color-drop-target);
						border-color: var(--color-accent);
					}
				}

				&[data-mark="wrong"] .blank-label {
					color: var(--color-error);
				}
			}
		}
	}
</style>
