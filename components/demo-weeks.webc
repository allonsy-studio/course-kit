<div webc:root="override" class="demo-weeks" webc:if="weeks?.length">
    <section class="week" webc:for="week of weeks" :id="`week-${week.week}`" :aria-labelledby="`week-${week.week}-heading`">
        <header class="week-head">
            <h2 class="week-title" :id="`week-${week.week}-heading`">Week <span @text="week.week"></span></h2>
            <p class="week-of" @text="week.dates"></p>
        </header>
        <ol class="meetings" role="list">
            <li class="meeting" webc:for="meeting of week.meetings">
                <p class="when" :data-date="meeting.iso">
                    <span class="weekday" @text="meeting.weekday"></span>
                    <span class="date" @text="meeting.date"></span>
                    <a class="lesson" webc:if="$data.audience.instructor" :href="`/lessons/week-${meeting.week}/day-${meeting.day}/`">Lesson plan</a>
                </p>
                <ul class="demos" role="list">
                    <li class="demo" webc:for="demo of meeting.demos">
                        <p class="demo-title"><a class="arrow" :href="demo.url"><span @text="demo.title"></span> <span aria-hidden="true">→</span></a></p>
                        <p class="repeat" webc:if="demo.firstShown">Shown again, first used <span @text="demo.firstShown"></span></p>
                        <template webc:nokeep webc:if="!demo.firstShown">
                            <p class="description" webc:if="demo.description" @text="demo.description"></p>
                            <p class="meta">
                                <a :href="demo.download" download>Download the HTML file</a>
                                <span webc:if="demo.alsoOn?.length">Used again <span @text="demo.alsoOn.join(', ')"></span></span>
                            </p>
                        </template>
                    </li>
                </ul>
                <p class="slides" webc:if="meeting.slides">
                    <a class="arrow" :href="meeting.slides">Slides <span aria-hidden="true">→</span></a>
                </p>
            </li>
        </ol>
    </section>
</div>

<style webc:scoped>
    /* The schedule's shape, kept to the weeks that had a demo: a tinted week
       band, then one row per meeting with the date down the left and that
       day's demos beside it, the deck link last so it sits in the same place
       on every row. Stacks to a single column on narrow screens. */
    :host {
        display: grid;
        gap: var(--content-space);
    }

    .week {
        margin: 0;
        padding: 0;
        border: var(--thin-border-width) solid var(--ui-light);
        border-radius: var(--standard-border-radius);
        overflow: hidden;
    }

    .week-head {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        gap: 0.25em 1em;
        padding: 0.55em 1em;
        background-color: var(--bg-light);
        border-block-end: var(--border-width) solid var(--section-ui);

        .week-title {
            margin: 0;
            font-size: var(--font-size-4);
        }
    }

    .week-of {
        margin: 0;
        color: var(--text-light);
        font-size: max(var(--base-font-size), 0.9em);
    }

    .meetings,
    .demos {
        list-style: none;
        margin: 0;
        padding: 0;
    }

    .meeting {
        display: grid;
        grid-template-columns: 8.5em minmax(0, 1fr);
        gap: 0.5em 1em;
        padding: 0.8em 1em;

        & + .meeting {
            border-block-start: var(--thin-border-width) solid var(--ui-light);
        }

        @media screen and (width <= 520px) {
            grid-template-columns: minmax(0, 1fr);
            gap: 0.25em;
        }
    }

    .when {
        display: flex;
        flex-direction: column;
        margin: 0;

        @media screen and (width <= 520px) {
            flex-direction: row;
            flex-wrap: wrap;
            gap: 0 0.5em;
            align-items: baseline;
        }
    }

    .weekday {
        font-weight: var(--font-weight--semi-bold);
    }

    .date,
    .lesson,
    .description,
    .repeat,
    .meta {
        color: var(--text-light);
        font-size: max(var(--base-font-size), 0.9em);
    }

    .lesson {
        margin-block-start: 0.35em;
    }

    .demo + .demo {
        margin-block-start: 0.8em;
    }

    .demo p {
        margin: 0;
        max-inline-size: 70ch;
    }

    .demo-title {
        font-size: max(var(--base-font-size), 1.05em);
    }

    .description,
    .repeat {
        margin-block-start: 0.15em;
    }

    .meta {
        display: flex;
        flex-wrap: wrap;
        gap: 0.25em 1em;
        margin-block-start: 0.25em;
    }

    .slides {
        grid-column: 2;
        margin: 0.35em 0 0;
        font-size: max(var(--base-font-size), 0.92em);

        @media screen and (width <= 520px) {
            grid-column: auto;
        }
    }

    .meeting:has([data-today]) {
        background-color: color-mix(in srgb, var(--section-ui) 15%, transparent);
        box-shadow: inset var(--border-width) 0 0 var(--section-ui);
    }

    .today-flag {
        color: var(--section-text);
        font-size: max(var(--base-font-size), 0.9em);
    }

    .arrow {
        color: var(--section-text);
        text-decoration: none;
        font-weight: var(--font-weight--medium);

        &:is(:hover, :focus-visible) {
            text-decoration: underline;
        }
    }
</style>
