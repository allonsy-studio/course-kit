<div class="judging">
	<div class="verdicts">
		<choice-list :@choices="q.verdicts" :@legend="$data.worksheet.copy.verdict"></choice-list>
	</div>
	<fieldset class="code-lines">
		<legend @text="$data.worksheet.copy.judgeLine"></legend>
		<label class="code-line" webc:for="codeLine of q.codeLines">
			<input type="radio" :name="codeLine.name" :value="codeLine.value">
			<code @text="codeLine.line"></code>
		</label>
		<label class="code-line no-line">
			<input type="radio" :name="q.lineName" value="none">
			<span @text="$data.worksheet.copy.judgeNoLine"></span>
		</label>
	</fieldset>
</div>

<style webc:scoped>
	:host {
		legend {
			color: var(--color-text-muted);
			font-size: 0.85em;
			letter-spacing: 0.06em;
			padding-inline: 0;
			text-transform: uppercase;
		}

		.code-lines {
			border: 0;
			margin: 0;
			margin-block-start: var(--content-space);
			/* A fieldset defaults to min-content, which defeats the code's scroll. */
			min-inline-size: 0;
			padding: 0;
		}

		.code-line {
			align-items: baseline;
			background: var(--color-surface);
			cursor: pointer;
			display: flex;
			gap: 0.6em;
			padding: 0.1em 0.5em;

			code {
				min-inline-size: 0;
				overflow-x: auto;
				white-space: pre;
			}

			&:first-of-type {
				border-start-end-radius: var(--standard-border-radius);
				border-start-start-radius: var(--standard-border-radius);
			}

			&.no-line {
				background: none;
				font-size: 0.9em;
				margin-block-start: 0.3em;
			}

			&[data-mark="right"] {
				background: color-mix(in srgb, var(--color-success) 22%, var(--color-page));
			}

			&[data-mark="wrong"] {
				background: color-mix(in srgb, var(--color-error) 22%, var(--color-page));
			}
		}
	}
</style>
