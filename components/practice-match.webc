<div class="matching">
	<p class="drag-hint" webc:if="q.dragHint" @text="q.dragHint"></p>
	<ol class="bank">
		<li webc:for="entry of q.bank" :draggable="entry.draggable" :data-letter="entry.letter">
			<span class="letter" @text="entry.letter"></span>
			<span @text="entry.text"></span>
		</li>
	</ol>
	<ol class="match-items">
		<li webc:for="item of q.items" :data-drop="item.drop">
			<label>
				<span class="match-text" @text="item.text"></span>
				<select :name="item.name" :data-blank="item.index">
					<option value="">—</option>
					<option webc:for="entry of item.bank" :value="entry.letter" @text="entry.letter"></option>
				</select>
			</label>
			<span class="answer-key" hidden :data-answer="item.answer">
				<span @text="`${$data.worksheet.copy.answer} ${item.answer}`"></span>
				<a webc:if="item.source" :href="item.source.href" @text="item.source.label"></a>
			</span>
		</li>
	</ol>
</div>

<style webc:scoped>
	:host {
		.drag-hint {
			color: var(--color-text-muted);
			font-size: 0.9em;
			margin-block: 0 0.6em;
		}

		.answer-key {
			color: var(--color-error);
			font-size: 0.85em;

			&:not([hidden]) {
				display: block;
			}

			a {
				color: inherit;
			}
		}

		.letter {
			background: var(--color-surface);
			border-radius: var(--standard-border-radius);
			display: inline-block;
			font-family: var(--mono-font);
			font-weight: var(--font-weight--semi-bold);
			min-inline-size: 1.7em;
			padding: 0.05em 0.35em;
			text-align: center;
			text-transform: uppercase;
		}

		.bank {
			background: var(--color-surface);
			border-radius: var(--standard-border-radius);
			list-style: none;
			padding: 0.6em 0.9em;

			li {
				display: flex;
				gap: 0.6em;
				margin-block: 0.25em;

				&[draggable="true"] {
					background: var(--color-page);
					border: var(--thin-border-width) dashed var(--color-border);
					border-radius: var(--standard-border-radius);
					cursor: grab;
					margin-block: 0;
					padding: 0.15em 0.5em;

					&:active {
						cursor: grabbing;
					}
				}

				&[data-dragging] {
					opacity: 0.45;
				}
			}

			/* With chips to drag, the bank reads better as a wrapped row of
			   tokens than as a stacked list. */
			&:has(li[draggable="true"]) {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5em;
			}
		}

		.match-items {
			padding-inline-start: 1.2em;

			label {
				align-items: center;
				display: flex;
				flex-wrap: wrap;
				gap: 0.6em;
			}

			/* The situation gets the room, up to a readable line, with the
			   select right after it; on a phone they still share a row. */
			.match-text {
				flex: 1 1 12em;
				max-inline-size: 36em;
			}

			select {
				flex: none;
				inline-size: 5em;
				margin-block: 0.2em;
			}

			li {
				&[data-drop] {
					border: var(--thin-border-width) dashed transparent;
					border-radius: var(--standard-border-radius);
					padding-inline: 0.4em;

					&[data-over] {
						background: var(--color-drop-target);
						border-color: var(--color-accent);
					}
				}

				&[data-dropped] select {
					border-color: var(--color-accent);
				}

				&[data-mark="wrong"] .match-text {
					color: var(--color-error);
				}
			}
		}
	}
</style>
