<ul role="list" webc:root="override" webc:if="items">
    <li webc:for="item of items">
        <h4><a :href="item.url" @text="item.name"></a></h4>
        <p @text="item.description" webc:if="item.description"></p>
    </li>
</ul>

<style webc:scoped>
    :host {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        gap: calc(var(--content-space) * .5);

        > li {
            font-size: 1em;

            h4 {
                font-weight: normal;
            }

            p {
                margin-block-start: 0;
            }
        }
    }

    :host([cards]) {
        grid-template-columns: repeat(auto-fill, minmax(min(100%, 15em), 1fr));
        gap: var(--content-space);

        @supports (grid-template-rows: subgrid) {
            > li {
                display: grid;
                grid-row: span 2;
                grid-template-rows: subgrid;
                row-gap: 0.3em;
                align-content: start;
            }
        }

        > li {
            position: relative;
            padding: calc(var(--content-space) * .9) var(--content-space);

            background-color: var(--bg-light);
            border: var(--thin-border-width) solid var(--ui-light);
            border-radius: var(--standard-border-radius);

            color: var(--text-light);
            font-size: max(var(--base-font-size), 0.92em);
            text-wrap: pretty;

            &:has(a:hover) {
                border-color: var(--ui);
                background-color: light-dark(color-mix(in sRGB, var(--static-paper) 92%, transparent), hsl(228deg 16% 26%));

                a {
                    color: var(--link--hover);
                }
            }

            &:has(a:focus-visible) {
                border-color: var(--ui);
                outline: var(--outline-width) solid var(--ui);
                outline-offset: 2px;
            }

            a {
                display: block;
                margin-block-end: 0.25em;

                color: var(--text);
                font-size: max(var(--base-font-size), 1.2em);
                font-weight: var(--font-weight--semi-bold);
                text-decoration: none;

                &::after {
                    content: "";
                    position: absolute;
                    inset: 0;
                    border-radius: inherit;
                }

                &:focus-visible {
                    outline: none;
                }
            }
        }
    }
</style>
