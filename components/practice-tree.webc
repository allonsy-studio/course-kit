<div class="tree-question">
	<pre class="snippet"><code @text="q.code"></code></pre>
	<ul class="dom-tree">
		<li webc:for="node of q.nodes" :style="`--depth: ${node.depth}`">
			<span class="node" webc:if="node.label" @text="node.label"></span>
			<label class="node node-blank" webc:if="node.label === undefined">
				<span class="sr-only" @text="node.blankLabel"></span>
				<input type="text" autocomplete="off" spellcheck="false" size="8"
					:name="node.name" :data-blank="node.blank">
			</label>
			<span class="answer-key" hidden webc:if="node.label === undefined" :data-answer="node.display"
				@text="`${$data.worksheet.copy.answer} ${node.display}`"></span>
		</li>
	</ul>
</div>

<style webc:scoped>
	:host {
		.answer-key {
			color: var(--color-error);
			font-size: 0.85em;

			&:not([hidden]) {
				display: block;
			}
		}

		.tree-question {
			display: grid;
			gap: var(--content-space);
			grid-template-columns: repeat(auto-fit, minmax(min(18rem, 100%), 1fr));
		}

		.dom-tree {
			font-family: var(--mono-font);
			list-style: none;
			margin-block: 0;
			padding-inline-start: 0;

			input {
				font-family: var(--mono-font);
			}

			li {
				margin-block: 0.25em;
				padding-inline-start: calc(var(--depth, 0) * 1.4em);
			}

			.node {
				border: var(--thin-border-width) solid var(--color-border);
				border-radius: var(--standard-border-radius);
				display: inline-block;
				padding: 0.1em 0.6em;
			}

			.node-blank {
				border-color: var(--color-accent);
				border-style: dashed;
				padding: 0.1em 0.3em;

				input {
					background: none;
					border: 0;
					inline-size: 7em;
					padding: 0;
				}

				li[data-mark="wrong"] & {
					border-color: var(--color-error);
				}
			}
		}
	}
</style>
