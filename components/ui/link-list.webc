<script webc:setup>
	/**
	 * A list of links, each with a name and an optional description. Give it the `items` array, or write the list in the default slot as a
	 * `<ul>` of links, or as a `<dl>` (`<dt>` the link, `<dd>` the description). The array wins when it has items; when it is missing or empty
	 * the slot is rendered instead.
	 * @prop {{ url: string, name: string, description?: string }[]} items the links to list
	 */
</script>
<ul role="list" webc:root="override" webc:if="items?.length">
    <li webc:for="item of items">
        <h4><a :href="item.url" @text="item.name"></a></h4>
        <p @text="item.description" webc:if="item.description"></p>
    </li>
</ul>
<div webc:root="override" webc:else><slot></slot></div>

<style webc:scoped>
    :host:not(:has(li, dt)) {
        display: none;
    }

    :host,
    :host > ul,
    :host > dl {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        gap: calc(var(--content-space) * .5);

        > dt {
            font-weight: normal;
        }

        > dd {
            margin: 0;
            color: var(--color-text-muted);
        }

        > li {
            font-size: 1em;

            h4 {
                font-weight: normal;
            }

            p {
                margin-block-start: 0;
            }
        }
    }

    :host([cards]),
    :host([cards]) > ul {
        grid-template-columns: repeat(auto-fill, minmax(min(100%, 15em), 1fr));
        gap: var(--content-space);

        @supports (grid-template-rows: subgrid) {
            > li {
                display: grid;
                grid-row: span 2;
                grid-template-rows: subgrid;
                row-gap: 0.3em;
                align-content: start;
            }
        }

        > li {
            position: relative;
            padding: calc(var(--content-space) * .9) var(--content-space);

            background-color: var(--color-surface);
            border: var(--thin-border-width) solid var(--color-border);
            border-radius: var(--standard-border-radius);

            color: var(--color-text-muted);
            font-size: max(var(--base-font-size), 0.92em);
            text-wrap: pretty;

            &:has(a:hover) {
                border-color: var(--color-accent);
                background-color: color-mix(in sRGB, var(--color-surface-overlay) 92%, transparent);

                a {
                    color: var(--color-link-hover);
                }
            }

            &:has(a:focus-visible) {
                border-color: var(--color-accent);
                outline: var(--focus-ring-width) solid var(--color-focus-ring);
                outline-offset: var(--focus-ring-offset);
            }

            a {
                display: block;
                margin-block-end: 0.25em;

                color: var(--color-text);
                font-size: max(var(--base-font-size), 1.2em);
                font-weight: var(--font-weight--semi-bold);
                text-decoration: none;

                &::after {
                    content: "";
                    position: absolute;
                    inset: 0;
                    border-radius: inherit;
                }

                &:focus-visible {
                    outline: none;
                }
            }
        }
    }
</style>
