<script webc:setup>
	/**
	 * A labelled list of readings or deadlines. Renders nothing when empty.
	 * @prop {string} label the heading above the list
	 * @prop {{ title: string, href?: string, check?: string, dueLabel?: string, kind?: string }[]} items the readings or deadlines to list
	 * @prop {string} [dueOn] how a due date reads after the check, with `{when}`: `copy.schedule.dueOn` ("due {when}"); without it the date stands alone
	 * @prop {boolean} [chips] put a `.due-chip` for the item's `kind` before its title; a bare `@chips` turns them on
	 * @prop {Record<string, string>} [kinds] the chip words by kind, from `copy.schedule.dueKind*`; needed with `chips`
	 */

	/** The muted line under an item: its check, then when it is due. Props are not in scope here, so the template passes `dueOn`. */
	/** A bare `@chips` reaches the template as "", so only an absent, null, `false` or "false" value turns chips off. */
	const on = (value) => value !== undefined && value !== null && value !== false && value !== "false";

	const detail = (item, dueOn) => [item.check, item.dueLabel && (dueOn ? dueOn.replace("{when}", item.dueLabel) : item.dueLabel)].filter(Boolean).join(", ");
</script>
<div webc:root="override" class="assigned" webc:if="items?.length">
	<p class="label" @text="label"></p>
	<ul role="list">
		<li webc:for="item of items" @attributes="on(chips) && item.kind ? { class: 'due-item', 'data-kind': item.kind } : {}">
			<span class="due-chip" webc:if="on(chips) && item.kind" :data-kind="item.kind" @text="kinds?.[item.kind]"></span>
			<a webc:if="item.href" :href="item.href" @text="item.title"></a>
			<span webc:if="!item.href" @text="item.title"></span>
			<span class="check" webc:if="detail(item, dueOn)" @text="detail(item, dueOn)"></span>
		</li>
	</ul>
</div>

<style webc:scoped>
	:host {
		/* Items sit clearly further apart than the lines inside one (WCAG 1.4.8). */
		ul {
			display: grid;
			gap: calc(var(--content-space) * 0.75);
			list-style: none;
			margin: 0;
			padding: 0;
		}

		/* A chip and its title share a row that wraps, so a long title never runs under the chip. */
		li {
			display: flex;
			flex-wrap: wrap;
			align-items: baseline;
			gap: 0.25em 0.5em;
		}
	}

	.label {
		margin: 0 0 calc(var(--content-space) * 0.5);
		color: var(--color-text-muted);
		text-transform: uppercase;
		letter-spacing: 0.05em;
		font-size: var(--font-size-6);
	}

	.check {
		flex-basis: 100%;
		line-height: var(--font-height);
		color: var(--color-text-muted);
		font-size: max(var(--base-font-size), 0.9em);
	}
</style>
