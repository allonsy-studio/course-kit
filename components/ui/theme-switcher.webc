<script webc:setup>
	/**
	 * The color-theme buttons: light, dark, plain HTML and the system default.
	 * `theme-restore.js` applies the saved choice before first paint.
	 */
    const labels = {
        light: { label: "Light mode", icon: "<sunshine></sunshine>" },
        dark: { label: "Dark mode", icon: "<moon></moon>" },
        nocss: { label: "Plain HTML, no styles", icon: "<nocss></nocss>" },
        system: { label: "System defaults", icon: "<system></system>" }
    };
</script>
<div webc:root="override" data-theme-switcher>
    <button type="button" popovertarget="theme-popover" aria-label="Theme">
        <span webc:for="mode of Object.keys(labels)" @html="labels[mode]?.icon" :data-mode="mode" :hidden="mode !== 'system'"></span>
    </button>
    <div id="theme-popover" popover>
        <ul>
            <li webc:for="mode of Object.keys(labels)">
                <button type="button" popovertarget="theme-popover" popovertargetaction="hide" :data-mode="mode" :aria-pressed="mode === 'system' ? 'true' : 'false'" @html="labels[mode]?.icon + ' ' + labels[mode]?.label"></button>
            </li>
        </ul>
    </div>
</div>
<style webc:scoped>
    :host {
        display: block;
    }

    :host > [popovertarget] {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0;

        inline-size: 2.1em;
        aspect-ratio: 1 / 1;
        padding: 0;
        margin: 0;

        color: var(--color-text-muted);
        background: transparent;
        border: var(--thin-border-width) solid var(--color-border);
        border-radius: var(--circle-border-radius);
        cursor: pointer;

        /* The popover tethers to this button; see [popover] below. */
        anchor-name: --theme-switcher;

        transition: color 0.2s ease-out, border-color 0.2s ease-out, background 0.2s ease-out;

        &:is(:hover, :focus-visible) {
            color: var(--color-text);
            border-color: var(--color-accent);
            background: var(--color-accent-hover);
        }

        &:focus-visible {
            outline: var(--outline-width) solid var(--color-accent);
            outline-offset: var(--outline-offset);
        }
    }

    svg {
        /* Block display kills the inline line box, whose descender space
           pushed the icon off-center inside the trigger's span. */
        display: block;
        inline-size: 1.1em;
        aspect-ratio: 1 / 1;
        flex: none;
        min-block-size: 0;
    }

    [popover] {
        display: none;
        opacity: 0;

        /* No anchor-positioning support: pin to the top of the viewport at
           the content column's inline-end edge, under the trigger. */
        position: fixed;
        inset: auto;
        inset-block-start: var(--container-space);
        inset-inline-end: calc((100% - var(--page-column)) / 2);

        min-inline-size: 11em;
        margin: 0;
        padding: 0.25em;
        border: var(--thin-border-width) solid var(--color-border);
        border-radius: var(--standard-border-radius);
        background: var(--color-surface-overlay);
        color: var(--color-text);
        box-shadow: var(--box-shadow);

        /* Keep every nested block below the plain declarations: engines
           without CSSNestedDeclarations drop declarations that follow a
           nested rule. */
        @supports (anchor-name: --a) {
            position-anchor: --theme-switcher;
            inset-block-start: calc(anchor(end) + 0.35em);
            inset-inline-end: anchor(end);
            position-try-fallbacks: flip-block;
        }

        @media (prefers-reduced-motion: no-preference) {
            translate: 0 -0.25em;
            transition:
                opacity 200ms ease-out,
                translate 200ms ease-out,
                display 200ms allow-discrete,
                overlay 200ms allow-discrete;
        }

        /* The polyfill can't implement :popover-open; it applies the
           .\:popover-open class instead — match both via :is() so browsers
           lacking the pseudo-class don't drop the whole rule. */
        &:is(:popover-open, .\:popover-open) {
            display: block;
            opacity: 1;
            translate: 0 0;

            @starting-style {
                opacity: 0;
                translate: 0 -0.25em;
            }
        }
    }

    [popover] ul {
        list-style: none;
        display: grid;
        gap: 2px;
        padding: 0;
        margin: 0;
    }

    [popover] button {
        display: flex;
        align-items: center;
        gap: 0.5em;

        inline-size: 100%;
        margin: 0;
        padding: 0.4em 0.6em;

        font: inherit;
        text-align: start;
        color: var(--color-text);
        background: transparent;
        border: none;
        border-radius: var(--standard-border-radius);
        cursor: pointer;

        &:is(:hover, :focus-visible) {
            background: var(--color-accent-hover);
        }

        &:focus-visible {
            outline: var(--outline-width) solid var(--color-accent);
            outline-offset: calc(-1 * var(--outline-width));
        }

        &[aria-pressed="true"] {
            font-weight: var(--font-weight--semi-bold);
            color: var(--color-accent-text);
        }
    }
</style>
<script>
    (function () {
        // The Popover API is Baseline newly available; older engines get the
        // popovertarget/light-dismiss behavior from the polyfill.
        if (!( "popover" in HTMLElement.prototype )) {
            import( "https://unpkg.com/@oddbird/popover-polyfill@latest/dist/popover.min.js" );
        }

        const order = [ "light", "dark", "nocss", "system" ];
        const labels = {
            light: "Light mode",
            dark: "Dark mode",
            nocss: "Plain HTML, no styles",
            system: "System defaults"
        };

        function stored() {
            try { return localStorage.getItem( "theme" ); }
            catch ( e ) { return null; }
        }
        function current() {
            const t = stored();
            // No stored choice (or an unrecognized one) means the visitor is
            // on the system default.
            return order.indexOf( t ) !== -1 ? t : "system";
        }
        function toggleStyles( disabled ) {
            document.querySelectorAll( 'link[rel="stylesheet"], style' ).forEach( function ( sheet ) {
                sheet.disabled = disabled;
            } );
        }
        function render() {
            const mode = current();
            document.querySelectorAll( "[data-theme-switcher]" ).forEach( function ( root ) {
                const trigger = root.querySelector( "[popovertarget]" );
                if ( trigger ) {
                    trigger.setAttribute( "aria-label", "Theme: " + ( labels[ mode ] || labels.system ) );
                    // The `hidden` attribute (not CSS) drives icon visibility
                    // so the control still reads correctly in no-CSS mode.
                    trigger.querySelectorAll( "[data-mode]" ).forEach( function ( icon ) {
                        icon.hidden = icon.dataset.mode !== mode;
                    } );
                }
                root.querySelectorAll( "[popover] button[data-mode]" ).forEach( function ( btn ) {
                    btn.setAttribute( "aria-pressed", String( btn.dataset.mode === mode ) );
                } );
            } );
        }
        function apply( mode ) {
            const root = document.documentElement;
            try {
                localStorage.setItem( "theme", mode );
                if ( mode === "nocss" ) {
                    root.style.colorScheme = "";
                    root.dataset.theme = "nocss";
                    toggleStyles( true );
                } else {
                    toggleStyles( false );
                    if ( mode === "system" ) {
                        // Clear the forced scheme; prism sheets go back to
                        // following the OS preference.
                        root.style.colorScheme = "";
                        delete root.dataset.theme;
                        document.querySelectorAll( "link[data-prism-theme]" ).forEach( function ( link ) {
                            link.media = "(prefers-color-scheme: " + link.dataset.prismTheme + ")";
                        } );
                    } else {
                        root.style.colorScheme = mode;
                        root.dataset.theme = mode;
                        // Prism themes ride along: pin the matching sheet on.
                        document.querySelectorAll( "link[data-prism-theme]" ).forEach( function ( link ) {
                            link.media = link.dataset.prismTheme === mode ? "all" : "not all";
                        } );
                    }
                }
            } catch ( e ) { }
            render();
        }

        document.querySelectorAll( "[data-theme-switcher] [popover] button[data-mode]" ).forEach( function ( button ) {
            button.addEventListener( "click", function () {
                apply( button.dataset.mode );
            } );
        } );

        // Restore state on load: the head script already forced light/dark
        // before paint, but no-CSS can only be applied once the stylesheets
        // exist in the DOM — and the trigger icon always needs syncing.
        if ( current() === "nocss" ) {
            apply( "nocss" );
        } else {
            render();
        }
    } )();
</script>
