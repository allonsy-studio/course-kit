<script webc:setup>
	/**
	 * A meeting's deck links, each on its own line: the slides, then any
	 * addendum. Renders nothing without either.
	 * @prop {{ slides?: string, addendum?: string }} meeting one meeting from `scheduleWeeks`
	 */
	/* Each link loops over its own href: a prop does not reach a nested component's attribute (docs/internals.md). */
</script>
<div webc:root="override" class="decks" webc:if="meeting.slides || meeting.addendum">
	<p webc:if="meeting.slides"><arrow-link webc:for="href of [meeting.slides]" :href="href">Slides</arrow-link></p>
	<p webc:if="meeting.addendum"><arrow-link webc:for="href of [meeting.addendum]" :href="href">Addendum</arrow-link></p>
</div>

<style webc:scoped>
	/* The row gap a meeting puts between its own items, kept between these lines. */
	:host {
		display: grid;
		gap: 0.5em;

		@media screen and (width <= 520px) {
			gap: 0.25em;
		}
	}

	:host p {
		margin: 0.35em 0 0;
		font-size: max(var(--base-font-size), 0.92em);
	}
</style>
