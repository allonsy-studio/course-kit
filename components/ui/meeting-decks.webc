<script webc:setup>
	/**
	 * A meeting's deck links, each on its own line: the slides, then any
	 * addendum. Renders nothing without either.
	 * @prop {{ slides?: string, addendum?: string }} meeting one meeting from `scheduleWeeks`
	 * @prop {string} slidesLabel the slides link's text, `copy.schedule.slides`
	 * @prop {string} addendumLabel the addendum link's text, `copy.schedule.addendum`
	 */
	/* Each link loops over its own href and label: a prop does not reach a nested component's attribute or slot (docs/internals.md). */
</script>
<div webc:root="override" class="decks" webc:if="meeting.slides || meeting.addendum">
	<p webc:if="meeting.slides"><arrow-link webc:for="link of [{ href: meeting.slides, label: slidesLabel }]" :href="link.href"><span @text="link.label"></span></arrow-link></p>
	<p webc:if="meeting.addendum"><arrow-link webc:for="link of [{ href: meeting.addendum, label: addendumLabel }]" :href="link.href"><span @text="link.label"></span></arrow-link></p>
</div>

<style webc:scoped>
	/* The row gap a meeting puts between its own items, kept between these lines. */
	:host {
		display: grid;
		gap: 0.5em;

		@media screen and (width <= 520px) {
			gap: 0.25em;
		}
	}

	:host p {
		margin: 0;
		font-size: max(var(--base-font-size), 0.92em);
	}

	/* A link is an operable target: 44px tall (WCAG 2.5.5). */
	:host a {
		display: inline-flex;
		align-items: center;
		min-block-size: var(--target-min);
	}
</style>
