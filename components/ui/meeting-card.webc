<script webc:setup>
	/**
	 * One class meeting in a week's list: the date down the left, the slot
	 * beside it. Marks itself as the scope `<today-marker>` highlights.
	 * @prop {{ iso: string, weekday: string, date: string }} meeting
	 * @slot when extra lines under the date (a note, a link)
	 * @slot default what the meeting holds; a child sits beside the date
	 */
</script>
<li webc:root="override" class="meeting" data-today-scope>
	<p class="when" :data-date="meeting.iso">
		<span class="weekday" @text="meeting.weekday"></span>
		<span class="date" @text="meeting.date"></span>
		<slot name="when"></slot>
	</p>
	<slot></slot>
</li>

<style webc:scoped>
	:host {
		display: grid;
		grid-template-columns: 8.5em minmax(0, 1fr);
		gap: 0.5em 1em;
		padding: 0.8em 1em;
		list-style: none;

		@media screen and (width <= 520px) {
			grid-template-columns: minmax(0, 1fr);
			gap: 0.25em;
		}

		/* Whatever the meeting holds sits in the second column, under its topics. */
		> :not(.when) {
			grid-column: 2;

			@media screen and (width <= 520px) {
				grid-column: auto;
			}
		}

		> .assigned {
			margin-block-start: 0.6em;
			font-size: max(var(--base-font-size), 0.92em);
		}
	}

	:host + :host {
		border-block-start: var(--thin-border-width) solid var(--color-border);
	}

	.when {
		display: flex;
		flex-direction: column;
		margin: 0;

		@media screen and (width <= 520px) {
			flex-direction: row;
			flex-wrap: wrap;
			gap: 0 0.5em;
			align-items: baseline;
		}
	}

	.weekday {
		font-weight: var(--font-weight--semi-bold);
	}

	.date {
		color: var(--color-text-muted);
		font-size: max(var(--base-font-size), 0.9em);
	}
</style>
