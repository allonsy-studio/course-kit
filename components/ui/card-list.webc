<script webc:setup>
	/**
	 * A list of cards, each linking to a page. A card shows the page's code, name and description unless the slot supplies its own content.
	 * Instead of `items` you can write the cards yourself as a `<ul>` of `<li>` cards in the `cards` slot (the default slot is taken: it is each card's
	 * own content); the array wins when it has items, and when it is missing or empty the `cards` slot is rendered instead. A card written in the slot
	 * must name its overlay link, as the items form does: `<li><a href="/x/" aria-labelledby="x-name"></a><h3 id="x-name">Name</h3></li>`.
	 * @prop {object[]} items pages, each with `data` and `page.url`
	 * @slot cards the cards as a `<ul>`, used when `items` is missing or empty
	 * @slot default each card's own content, in place of its code, name and description
	 */
</script>
<ul role="list" webc:root="override" webc:if="items?.length">
    <li webc:for="item of items">
        <a :href="item.page.url" webc:if="item.page.url" :aria-labelledby="slugify(item.data.name)"></a>
        <slot :@item="item">
            <eyebrow @text="item.data.code"></eyebrow>
            <h3 @text="item.data.name" :id="slugify(item.data.name)"></h3>
            <p @text="item.data.description" webc:if="item.data.description"></p>
        </slot>
    </li>
</ul>
<div webc:root="override" webc:else><slot name="cards"></slot></div>

<style webc:scoped>
    :host:not(:has(li)) {
        display: none;
    }

    :is(:host, :host > ul) {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        gap: calc(var(--content-space) * 1.5);

        > li {
            font-size: 1em;
            position: relative;
            background-color: var(--color-surface);
            border: var(--thick-border-width) solid transparent;
            border-radius: var(--standard-border-radius);
            padding-block: calc(var(--content-space) * 1.5);
            padding-inline: calc(var(--content-space) * 1);

            a {
                display: block;
                position: absolute;
                pointer-events: all;
                inset: calc(-1 * var(--thick-border-width));
                z-index: 1;
                text-decoration: none;
                color: inherit;
                background-color: transparent;
                border: none;
                padding: 0;
            }

            &::before {
                content: "";
                position: absolute;
                inset: calc(-1 * var(--thick-border-width));
                border-radius: inherit;
                padding: var(--thick-border-width);
                background: linear-gradient(to bottom right, var(--gradient-stops));
                background-size: 200% 200%;
                -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
                -webkit-mask-composite: xor;
                mask: linear-gradient(#000 0 0) content-box exclude, linear-gradient(#000 0 0);
                pointer-events: none;
            }

            &:has(a) {
                @media (prefers-reduced-motion: reduce) {
                    &:is(:hover, :focus, :focus-within) {
                        background-color: color-mix(in sRGB, var(--color-surface-overlay) 90%, transparent);
                    }

                    &:is(:hover,:focus,:focus-within)::before {
                        background-position: 0% 0%;
                    }

                }

                @media not (prefers-reduced-motion: reduce) {
                    &:is(:hover,:focus,:focus-within)::before {
                        animation: gradient-drift 2s ease-in-out infinite alternate;
                    }
                }
            }

            @media print {
                background-color: transparent;
                border-color: var(--color-border);

                &::before {
                    display: none;
                }
            }
        }

        h3 {
            margin-block: 1rem;
        }

        p {
            text-decoration: none;

            &:last-child {
                margin-block-end: 0;
            }
        }
    }

    @keyframes gradient-drift {
        from {
            background-position: 0% 0%;
        }

        to {
            background-position: 100% 100%;
        }
    }
</style>
